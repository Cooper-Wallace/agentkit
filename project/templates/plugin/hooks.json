{
  "plugin-pre-run-hook": {
    "enabled": false,
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "echo '[plugin-hook] Verifying execution context...'",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
