{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "version": "1.0.0",
  "description": "Standardized pre-approved commands for Google Antigravity CLI across developer workstations.",
  "categories": {
    "core_inspection": {
      "description": "Read-only system inspection, file reading, and search utilities.",
      "commands": [
        "which",
        "cat",
        "head",
        "tail",
        "grep",
        "ls",
        "pwd",
        "echo",
        "diff",
        "wc",
        "find",
        "file",
        "tree",
        "fastfetch"
      ]
    },
    "safe_file_operations": {
      "description": "Non-destructive file and directory creation, moving, and permission adjustments (rm is deliberately excluded).",
      "commands": [
        "mkdir",
        "touch",
        "cp",
        "mv",
        "chmod",
        "ln"
      ]
    },
    "git_hygiene": {
      "description": "Standard version control workflows and inspection commands.",
      "commands": [
        "git status",
        "git diff",
        "git log",
        "git show",
        "git branch",
        "git checkout",
        "git switch",
        "git fetch",
        "git pull",
        "git add",
        "git commit",
        "git remote",
        "git config",
        "git init",
        "git stash",
        "git rebase",
        "git worktree",
        "git rev-parse",
        "git ls-files"
      ]
    },
    "github_governance": {
      "description": "GitHub CLI automation and repository governance tools.",
      "commands": [
        "gh",
        "gh pr",
        "gh issue",
        "gh repo",
        "gh auth",
        "repokit",
        "gh-standardise",
        "gh-standardize"
      ]
    },
    "system_and_environment": {
      "description": "Querying workstation environment, hostnames, and user identities.",
      "commands": [
        "uname",
        "hostname",
        "date",
        "env",
        "whoami",
        "id"
      ]
    },
    "package_querying": {
      "description": "Package manager queries and manifest inspections without administrative elevation.",
      "commands": [
        "apt-cache",
        "apt-mark",
        "dpkg -l",
        "flatpak",
        "snap list"
      ]
    },
    "test_runners_and_runtimes": {
      "description": "Common development runtimes and automated test harnesses.",
      "commands": [
        "python3 -m unittest discover tests",
        "python3 -m unittest discover",
        "pytest",
        "python3",
        "python",
        "node",
        "npm test",
        "npm run",
        "pnpm",
        "yarn",
        "mvn test",
        "cargo test",
        "go test"
      ]
    },
    "local_workflows": {
      "description": "Workstation provisioning scripts, agent harness standardisation, and agentkit tooling.",
      "commands": [
        "./bootstrap.sh",
        "./install.sh",
        "./plasma/restore-kde.sh",
        "konsole",
        "agy",
        "agentkit",
        "agentkit vault",
        "agentkit vault *",
        "workstation-setup",
        "ws-setup"
      ]
    },
    "context_and_memory_optimization": {
      "description": "Context compression, reversible retrieval, and AST-based repository packing tools.",
      "commands": [
        "headroom",
        "repomix"
      ]
    }
  },
  "mcp_tools": {
    "memory": {
      "description": "Cross-thread and cross-repository persistent memory knowledge graph.",
      "permissions": [
        "mcp(memory)",
        "mcp(memory/*)",
        "mcp(memory/create_entities)",
        "mcp(memory/create_relations)",
        "mcp(memory/add_observations)",
        "mcp(memory/delete_entities)",
        "mcp(memory/delete_observations)",
        "mcp(memory/delete_relations)",
        "mcp(memory/read_graph)",
        "mcp(memory/search_nodes)",
        "mcp(memory/open_nodes)"
      ]
    },
    "repomix": {
      "description": "AST-compressed repository packing and analysis.",
      "permissions": [
        "mcp(repomix)",
        "mcp(repomix/*)",
        "mcp(repomix/pack_codebase)",
        "mcp(repomix/read_repomix_output)",
        "mcp(repomix/grep_repomix_output)",
        "mcp(repomix/pack_remote_repository)",
        "mcp(repomix/generate_skill)",
        "mcp(repomix/attach_packed_output)"
      ]
    },
    "github": {
      "description": "GitHub MCP integration for issues, pull requests, and repository operations.",
      "permissions": [
        "mcp(github)",
        "mcp(github/*)",
        "mcp(github/create_or_update_file)",
        "mcp(github/list_commits)",
        "mcp(github/search_code)",
        "mcp(github/get_pull_request)",
        "mcp(github/list_pull_requests)",
        "mcp(github/create_issue)",
        "mcp(github/update_issue)",
        "mcp(github/list_issues)",
        "mcp(github/push_files)",
        "mcp(github/merge_pull_request)",
        "mcp(github/get_file_contents)",
        "mcp(github/create_pull_request)",
        "mcp(github/create_branch)",
        "mcp(github/fork_repository)",
        "mcp(github/search_issues)",
        "mcp(github/get_issue)",
        "mcp(github/search_repositories)",
        "mcp(github/create_repository)",
        "mcp(github/search_users)",
        "mcp(github/add_issue_comment)",
        "mcp(github/create_pull_request_review)",
        "mcp(github/get_pull_request_files)",
        "mcp(github/get_pull_request_status)",
        "mcp(github/update_pull_request_branch)",
        "mcp(github/get_pull_request_comments)",
        "mcp(github/get_pull_request_reviews)"
      ]
    },
    "fetch": {
      "description": "Web fetch and content conversion tool.",
      "permissions": [
        "mcp(fetch)",
        "mcp(fetch/*)",
        "mcp(fetch/fetch)"
      ]
    }
  },
  "tools": {
    "provisioned_tools": {
      "description": "Core harness tools for MCP interactions and resource access.",
      "permissions": [
        "call_mcp_tool",
        "call_mcp_tool(*)",
        "list_resources",
        "read_resource"
      ]
    }
  }
}
