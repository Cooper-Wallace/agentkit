{
  "wake-lock-activity": {
    "enabled": true,
    "PreInvocation": [
      {
        "type": "command",
        "command": "./scripts/notify-wake.py active",
        "timeout": 5
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "./scripts/notify-wake.py active",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "./scripts/notify-wake.py idle",
        "timeout": 5
      }
    ]
  }
}
