{
  "git-safety-guard": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "./scripts/guard-git-operations.sh",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "quality-completion-gate": {
    "enabled": true,
    "Stop": [
      {
        "type": "command",
        "command": "./scripts/verify-clean-completion.sh",
        "timeout": 60
      }
    ]
  }
}
