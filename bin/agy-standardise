#!/usr/bin/env python3
"""
agy-standardise: Standardize Google Antigravity CLI permissions, agent rules, and configs.

Features:
- Audit Antigravity CLI settings, command permissions, and global GEMINI.md rules.
- Safely merge standard pre-approved commands into settings.json without overwriting custom rules or workspaces.
- Automated backup creation (settings.json.bak.<timestamp>) and full --dry-run support.
- Snapshot / export locally approved commands back to repository manifests.
- Diff local machine state against standardized declarative catalog.
- Scaffold project-level GEMINI.md / AGENTS.md rulesets into repositories.
- Install local Conventional Commits git hooks.
"""

import argparse
import datetime
import difflib
import json
import os
import re
import shutil
import sys
from pathlib import Path
from typing import Any, Dict, List, Optional, Set, Tuple

# Terminal colors and formatting
GREEN = "\033[1;32m"
RED = "\033[1;31m"
YELLOW = "\033[1;33m"
BLUE = "\033[1;34m"
CYAN = "\033[1;36m"
BOLD = "\033[1m"
RESET = "\033[0m"

# Project root resolution
SCRIPT_DIR = Path(__file__).resolve().parent
REPO_ROOT = SCRIPT_DIR.parent
CONFIG_DIR = REPO_ROOT / "config"
TEMPLATES_DIR = REPO_ROOT / "templates"
PERMISSIONS_FILE = CONFIG_DIR / "permissions.json"
SETTINGS_DEFAULT_FILE = CONFIG_DIR / "settings.default.json"

DEFAULT_SETTINGS_PATH = Path.home() / ".gemini" / "antigravity-cli" / "settings.json"
DEFAULT_GLOBAL_GEMINI_DIR = Path.home() / ".gemini"
MCP_CATALOG_FILE = CONFIG_DIR / "mcp.json"
DEFAULT_MCP_CONFIG_PATH = Path.home() / ".gemini" / "config" / "mcp_config.json"
PLUGINS_SRC_DIR = REPO_ROOT / "plugins"
DEFAULT_GLOBAL_PLUGINS_DIR = Path.home() / ".gemini" / "config" / "plugins"
DEFAULT_BASHRC_PATH = Path.home() / ".bashrc"

BASHRC_ENV_BLOCK_START = "# >>> Antigravity Standards Environment >>>"
BASHRC_ENV_BLOCK_END = "# <<< Antigravity Standards Environment <<<"

# Conventional commit regex pattern (aligning with gh-standardise)
COMMIT_PATTERN = (
    r"^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)"
    r"(\([a-zA-Z0-9_\-\.]+\))?!?: .+$"
)


def print_step(title: str) -> None:
    print(f"\n{BOLD}{BLUE}==>{RESET} {BOLD}{title}{RESET}")


def print_success(msg: str) -> None:
    print(f"  {GREEN}✔{RESET} {msg}")


def print_failure(msg: str) -> None:
    print(f"  {RED}✖{RESET} {msg}")


def print_warning(msg: str) -> None:
    print(f"  {YELLOW}⚠{RESET} {msg}")


def print_info(msg: str) -> None:
    print(f"  {CYAN}ℹ{RESET} {msg}")


def load_json(path: Path) -> Dict[str, Any]:
    """Load and parse a JSON file."""
    with open(path, "r", encoding="utf-8") as f:
        return json.load(f)


def save_json(path: Path, data: Dict[str, Any]) -> None:
    """Save dictionary to a formatted JSON file."""
    path.parent.mkdir(parents=True, exist_ok=True)
    with open(path, "w", encoding="utf-8") as f:
        json.dump(data, f, indent=2, ensure_ascii=False)
        f.write("\n")


def get_standard_permissions_catalog() -> Dict[str, Any]:
    """Load standard permissions catalog from repository config."""
    if not PERMISSIONS_FILE.exists():
        raise FileNotFoundError(f"Missing permissions catalog at: {PERMISSIONS_FILE}")
    return load_json(PERMISSIONS_FILE)


def get_flat_standard_permissions(catalog: Optional[Dict[str, Any]] = None) -> List[str]:
    """Extract flat list of command(...) permission strings from catalog."""
    if catalog is None:
        catalog = get_standard_permissions_catalog()

    permissions: List[str] = []
    for cat_data in catalog.get("categories", {}).values():
        for cmd in cat_data.get("commands", []):
            perm_str = f"command({cmd})"
            if perm_str not in permissions:
                permissions.append(perm_str)
    return permissions


def load_user_settings(settings_path: Path) -> Tuple[Dict[str, Any], bool]:
    """Load user settings.json. Returns (dict, file_exists)."""
    if not settings_path.exists():
        return {}, False
    try:
        return load_json(settings_path), True
    except json.JSONDecodeError as err:
        raise ValueError(f"Corrupted JSON in {settings_path}: {err}")


def merge_permissions(
    existing_settings: Dict[str, Any],
    standard_permissions: List[str],
    default_settings: Optional[Dict[str, Any]] = None,
) -> Tuple[Dict[str, Any], List[str]]:
    """
    Idempotently merge standard permissions into existing settings.
    Preserves custom permissions, trusted workspaces, and user preferences.
    Returns (merged_settings_dict, list_of_newly_added_permissions).
    """
    result = dict(existing_settings)

    # Apply default baseline settings if missing
    if default_settings:
        for key, value in default_settings.items():
            if key not in result:
                result[key] = value

    if "permissions" not in result or not isinstance(result["permissions"], dict):
        result["permissions"] = {}

    current_allow: List[str] = result["permissions"].get("allow", [])
    if not isinstance(current_allow, list):
        current_allow = []

    current_set: Set[str] = set(current_allow)
    added_permissions: List[str] = []

    merged_allow = list(current_allow)
    for perm in standard_permissions:
        if perm not in current_set:
            merged_allow.append(perm)
            added_permissions.append(perm)
            current_set.add(perm)

    result["permissions"]["allow"] = merged_allow

    # Ensure trustedWorkspaces exists as a list if not already present
    if "trustedWorkspaces" not in result:
        result["trustedWorkspaces"] = []

    return result, added_permissions


def get_standard_mcp_catalog() -> Dict[str, Any]:
    """Load standard MCP catalog from repository config."""
    if not MCP_CATALOG_FILE.exists():
        return {"mcpServers": {}, "_requirements": {}}
    return load_json(MCP_CATALOG_FILE)


def load_user_mcp_config(mcp_path: Path) -> Tuple[Dict[str, Any], bool]:
    """Load user mcp_config.json. Returns (dict, file_exists)."""
    if not mcp_path.exists():
        return {"mcpServers": {}}, False
    try:
        data = load_json(mcp_path)
        if "mcpServers" not in data or not isinstance(data["mcpServers"], dict):
            data["mcpServers"] = {}
        return data, True
    except json.JSONDecodeError as err:
        raise ValueError(f"Corrupted JSON in {mcp_path}: {err}")


def merge_mcp_servers(
    existing_mcp: Dict[str, Any],
    standard_catalog: Dict[str, Any],
) -> Tuple[Dict[str, Any], List[str]]:
    """
    Idempotently merge standard MCP servers into existing mcp_config.json.
    Preserves custom/local MCP servers.
    Returns (merged_dict, list_of_newly_added_server_keys).
    """
    result = dict(existing_mcp)
    if "mcpServers" not in result or not isinstance(result["mcpServers"], dict):
        result["mcpServers"] = {}

    current_servers = dict(result["mcpServers"])
    standard_servers = standard_catalog.get("mcpServers", {})
    added_servers: List[str] = []

    for name, srv_def in standard_servers.items():
        if name not in current_servers:
            current_servers[name] = srv_def
            added_servers.append(name)

    result["mcpServers"] = current_servers
    return result, added_servers


def audit_mcp_requirements(
    mcp_catalog: Dict[str, Any],
) -> List[Dict[str, Any]]:
    """
    Inspect the host environment against MCP requirements.
    Checks required binaries (via shutil.which) and required environment variables (via os.environ).
    Returns list of requirement status dicts.
    """
    diagnostics = []
    requirements = mcp_catalog.get("_requirements", {})
    standard_servers = mcp_catalog.get("mcpServers", {})

    for server_name in standard_servers.keys():
        req = requirements.get(server_name, {})
        desc = req.get("description", "")
        required_bins = req.get("required_bins", [])
        required_env = req.get("required_env", [])
        setup_hint = req.get("setup_hint", "")

        missing_bins = [b for b in required_bins if shutil.which(b) is None]
        missing_env = [v for v in required_env if not os.environ.get(v)]

        diagnostics.append({
            "server": server_name,
            "description": desc,
            "required_bins": required_bins,
            "missing_bins": missing_bins,
            "required_env": required_env,
            "missing_env": missing_env,
            "setup_hint": setup_hint,
            "ready": len(missing_bins) == 0 and len(missing_env) == 0,
        })
    return diagnostics


def get_standard_bashrc_block() -> str:
    """Return the managed environment block for ~/.bashrc."""
    return f"""{BASHRC_ENV_BLOCK_START}
# Dynamically resolve GitHub token from gh keyring if not already exported
if command -v gh >/dev/null 2>&1; then
    export GITHUB_PERSONAL_ACCESS_TOKEN="${{GITHUB_PERSONAL_ACCESS_TOKEN:-$(gh auth token 2>/dev/null)}}"
fi

# Default SQLite development database path for Antigravity SQLite MCP server
export SQLITE_DEV_DB="${{SQLITE_DEV_DB:-$HOME/dev.db}}"
{BASHRC_ENV_BLOCK_END}"""


def configure_bashrc_environment(
    bashrc_path: Path, dry_run: bool = False
) -> Tuple[bool, str]:
    """
    Idempotently inject or update the managed Antigravity environment block in ~/.bashrc.
    Ensures dev.db is initialized if missing.
    Returns (changed, message).
    """
    block = get_standard_bashrc_block()
    content = ""
    if bashrc_path.exists():
        content = bashrc_path.read_text(encoding="utf-8")

    pattern = re.compile(
        rf"{re.escape(BASHRC_ENV_BLOCK_START)}.*?{re.escape(BASHRC_ENV_BLOCK_END)}",
        re.DOTALL,
    )

    if pattern.search(content):
        current_block = pattern.search(content).group(0)
        if current_block.strip() == block.strip():
            return False, "Environment block is already up to date."
        new_content = pattern.sub(block, content)
    else:
        new_content = content.rstrip() + "\n\n" + block + "\n"

    dev_db = Path.home() / "dev.db"
    if not dry_run:
        bashrc_path.parent.mkdir(parents=True, exist_ok=True)
        bashrc_path.write_text(new_content, encoding="utf-8")
        if not dev_db.exists():
            try:
                dev_db.touch()
            except Exception:
                pass

        # Also sync ~/.profile for login / non-interactive desktop sessions
        if bashrc_path == DEFAULT_BASHRC_PATH:
            profile_path = Path.home() / ".profile"
            if profile_path.exists():
                prof_content = profile_path.read_text(encoding="utf-8")
                if pattern.search(prof_content):
                    prof_content = pattern.sub(block, prof_content)
                else:
                    prof_content = prof_content.rstrip() + "\n\n" + block + "\n"
                profile_path.write_text(prof_content, encoding="utf-8")

    return True, "Configured Antigravity environment variables in shell configuration."


# ==============================================================================
# Commands
# ==============================================================================


def cmd_audit(args: argparse.Namespace) -> int:
    """Audit the current machine's Antigravity CLI configuration against standards."""
    settings_path = Path(args.settings_path).expanduser().resolve()
    print(f"\n{BOLD}Auditing Antigravity CLI Standards{RESET}")
    print(f"Target Settings: {CYAN}{settings_path}{RESET}")

    total_checks = 0
    passed_checks = 0

    catalog = get_standard_permissions_catalog()
    standard_permissions = get_flat_standard_permissions(catalog)

    # 1. Settings File Existence Check
    total_checks += 1
    settings, exists = load_user_settings(settings_path)
    if exists:
        print_success(f"Settings file exists ({settings_path})")
        passed_checks += 1
    else:
        print_failure(f"Settings file missing ({settings_path})")

    # 2. Permissions Allow List
    user_allow = []
    if exists and "permissions" in settings and isinstance(settings["permissions"], dict):
        user_allow = settings["permissions"].get("allow", [])
        if not isinstance(user_allow, list):
            user_allow = []

    user_allow_set = set(user_allow)
    missing_permissions = [p for p in standard_permissions if p not in user_allow_set]

    total_checks += 1
    if not missing_permissions:
        print_success(f"Standard Permissions: All {len(standard_permissions)} pre-approved commands active")
        passed_checks += 1
    else:
        print_failure(
            f"Standard Permissions: {len(missing_permissions)} of {len(standard_permissions)} commands missing"
        )
        if args.verbose:
            print(f"    {YELLOW}Missing permissions:{RESET}")
            for p in missing_permissions:
                print(f"      - {p}")

    # 3. Category Breakdown (when verbose)
    if args.verbose:
        print_step("Permission Category Breakdown")
        for cat_name, cat_data in catalog.get("categories", {}).items():
            cat_cmds = [f"command({c})" for c in cat_data.get("commands", [])]
            cat_present = [p for p in cat_cmds if p in user_allow_set]
            status_color = GREEN if len(cat_present) == len(cat_cmds) else YELLOW
            print(f"  {status_color}•{RESET} {BOLD}{cat_name}{RESET}: {len(cat_present)}/{len(cat_cmds)} commands active")

    # 4. Global GEMINI.md / AGENTS.md Directives
    total_checks += 1
    target_gemini_dir = Path(getattr(args, "gemini_dir", DEFAULT_GLOBAL_GEMINI_DIR)).expanduser().resolve()
    global_gemini = target_gemini_dir / "GEMINI.md"
    global_agents = target_gemini_dir / "AGENTS.md"
    if global_gemini.exists() or global_agents.exists():
        target_found = global_gemini if global_gemini.exists() else global_agents
        print_success(f"Global Agent Directives installed ({target_found})")
        passed_checks += 1
    else:
        print_failure(f"Global Agent Directives missing ({global_gemini})")

    # 5. Non-workspace access setting
    total_checks += 1
    if settings.get("allowNonWorkspaceAccess") is True:
        print_success("Workspace Boundary: 'allowNonWorkspaceAccess' enabled")
        passed_checks += 1
    else:
        print_warning("Workspace Boundary: 'allowNonWorkspaceAccess' not explicitly enabled")

    # 6. Color Scheme Check
    total_checks += 1
    if settings.get("colorScheme") == "dark":
        print_success("UI Theme: 'colorScheme' set to 'dark'")
        passed_checks += 1
    else:
        print_info(f"UI Theme: 'colorScheme' is '{settings.get('colorScheme', 'not set')}'")
        passed_checks += 1

    # 7. PATH verification for ~/.local/bin
    total_checks += 1
    local_bin = str(Path.home() / ".local" / "bin")
    current_path = os.environ.get("PATH", "")
    if f":{local_bin}:" in f":{current_path}:":
        print_success(f"Environment PATH includes {local_bin}")
        passed_checks += 1
    else:
        print_warning(f"Environment PATH missing {local_bin}")

    # 8. MCP Server Standards & Environment Diagnostics
    if not getattr(args, "no_mcp", False):
        mcp_path = Path(getattr(args, "mcp_path", DEFAULT_MCP_CONFIG_PATH)).expanduser().resolve()
        mcp_catalog = get_standard_mcp_catalog()
        std_servers = mcp_catalog.get("mcpServers", {})

        total_checks += 1
        user_mcp, mcp_exists = load_user_mcp_config(mcp_path)
        configured_servers = user_mcp.get("mcpServers", {})
        missing_mcp = [s for s in std_servers.keys() if s not in configured_servers]

        if not missing_mcp:
            print_success(f"MCP Configuration: All {len(std_servers)} standard servers configured ({mcp_path})")
            passed_checks += 1
        else:
            print_failure(f"MCP Configuration: {len(missing_mcp)} of {len(std_servers)} standard servers missing ({', '.join(missing_mcp)})")

        # Environment & Binary Diagnostics
        mcp_diagnostics = audit_mcp_requirements(mcp_catalog)
        missing_env_advisories = []
        for diag in mcp_diagnostics:
            s_name = diag["server"]
            if diag["ready"]:
                if args.verbose:
                    print_success(f"MCP '{s_name}': Dependencies and environment ready")
            else:
                if diag["missing_bins"]:
                    print_warning(f"MCP '{s_name}': Missing required binary in PATH: {', '.join(diag['missing_bins'])}")
                if diag["missing_env"]:
                    print_warning(f"MCP '{s_name}': Missing environment variable: {', '.join(diag['missing_env'])}")
                    if diag["setup_hint"]:
                        missing_env_advisories.append((s_name, diag["setup_hint"]))

        if missing_env_advisories and args.verbose:
            print_step("MCP Environment Setup Advisories")
            for s_name, hint in missing_env_advisories:
                print(f"  {CYAN}ℹ{RESET} {BOLD}{s_name}{RESET}: {hint}")

    # 9. Standard Plugins Audit
    if not getattr(args, "no_plugins", False):
        plugins_dir = Path(getattr(args, "plugins_dir", DEFAULT_GLOBAL_PLUGINS_DIR)).expanduser().resolve()
        if PLUGINS_SRC_DIR.exists():
            for plugin_path in sorted(PLUGINS_SRC_DIR.iterdir()):
                if plugin_path.is_dir() and (plugin_path / "plugin.json").exists():
                    total_checks += 1
                    target_plugin = plugins_dir / plugin_path.name
                    target_manifest = target_plugin / "plugin.json"
                    if target_manifest.exists():
                        scripts_dir = target_plugin / "scripts"
                        all_executable = True
                        if scripts_dir.exists():
                            for script in scripts_dir.iterdir():
                                if script.is_file() and not os.access(script, os.X_OK):
                                    all_executable = False
                        if all_executable:
                            print_success(f"Plugin '{plugin_path.name}' installed and operational ({target_plugin})")
                            passed_checks += 1
                        else:
                            print_warning(f"Plugin '{plugin_path.name}' scripts missing executable permission (+x)")
                            passed_checks += 1
                    else:
                        print_failure(f"Plugin '{plugin_path.name}' missing ({target_plugin})")

    # 10. Shell Environment Check (~/.bashrc)
    if not getattr(args, "no_env", False):
        total_checks += 1
        bashrc_path = Path(getattr(args, "bashrc_path", DEFAULT_BASHRC_PATH)).expanduser().resolve()
        has_block = False
        if bashrc_path.exists():
            has_block = BASHRC_ENV_BLOCK_START in bashrc_path.read_text(encoding="utf-8")
        has_env = bool(os.environ.get("GITHUB_PERSONAL_ACCESS_TOKEN") and os.environ.get("SQLITE_DEV_DB"))

        if has_block or has_env:
            print_success(f"Shell Environment: Antigravity MCP variables configured ({bashrc_path})")
            passed_checks += 1
        else:
            print_warning(f"Shell Environment: Antigravity MCP variables missing in {bashrc_path}")

    # Summary
    print("\n" + "─" * 60)
    score_pct = int((passed_checks / total_checks) * 100) if total_checks else 0
    if passed_checks == total_checks:
        print(f"{BOLD}{GREEN}[SUCCESS]{RESET} Antigravity CLI configuration is fully compliant! ({passed_checks}/{total_checks} checks passed)")
        return 0
    else:
        print(
            f"{BOLD}{YELLOW}[NON-COMPLIANT]{RESET} Compliance score: {score_pct}% "
            f"({passed_checks}/{total_checks} checks passed)."
        )
        print(f"Run {BOLD}agy-standardise apply{RESET} to bring your workstation into compliance.")
        return 1


def cmd_apply(args: argparse.Namespace) -> int:
    """Apply standard permissions and configure global agent directives."""
    settings_path = Path(args.settings_path).expanduser().resolve()
    print_step(f"Applying Antigravity Standards to: {settings_path}")

    catalog = get_standard_permissions_catalog()
    standard_permissions = get_flat_standard_permissions(catalog)
    default_settings = load_json(SETTINGS_DEFAULT_FILE) if SETTINGS_DEFAULT_FILE.exists() else {}

    existing_settings, exists = load_user_settings(settings_path)
    merged_settings, added = merge_permissions(existing_settings, standard_permissions, default_settings)

    # 1. Show permission additions
    if added:
        print_info(f"Adding {len(added)} missing standard permissions:")
        for perm in added:
            print(f"    {GREEN}+{RESET} {perm}")
    else:
        print_success("All standard permissions are already present.")

    # 2. Backup and Write Settings
    if not args.dry_run:
        if exists and not args.no_backup:
            timestamp = datetime.datetime.now().strftime("%Y%m%d_%H%M%S")
            backup_path = settings_path.with_name(f"{settings_path.name}.bak.{timestamp}")
            shutil.copy2(settings_path, backup_path)
            print_success(f"Created backup: {backup_path}")

        save_json(settings_path, merged_settings)
        print_success(f"Updated {settings_path}")
    else:
        print_warning("[DRY-RUN] Skipped writing settings.json updates.")

    # 3. Global GEMINI.md / AGENTS.md Linking
    template_gemini = TEMPLATES_DIR / "GEMINI.md"
    if not template_gemini.exists():
        print_failure(f"Template GEMINI.md not found at: {template_gemini}")
        return 1

    target_gemini_dir = Path(getattr(args, "gemini_dir", DEFAULT_GLOBAL_GEMINI_DIR)).expanduser().resolve()
    target_gemini_file = target_gemini_dir / "GEMINI.md"
    target_agents_file = target_gemini_dir / "AGENTS.md"

    if not args.dry_run:
        target_gemini_dir.mkdir(parents=True, exist_ok=True)

        # Create symlinks or copy
        if target_gemini_file.exists() or target_gemini_file.is_symlink():
            target_gemini_file.unlink()
        target_gemini_file.symlink_to(template_gemini)
        print_success(f"Linked global directives: {target_gemini_file} -> {template_gemini}")

        if target_agents_file.exists() or target_agents_file.is_symlink():
            target_agents_file.unlink()
        target_agents_file.symlink_to(template_gemini)
        print_success(f"Linked global directives: {target_agents_file} -> {template_gemini}")

        if args.link_home:
            home_gemini = Path.home() / "GEMINI.md"
            if home_gemini.exists() or home_gemini.is_symlink():
                home_gemini.unlink()
            home_gemini.symlink_to(template_gemini)
            print_success(f"Linked home directives: {home_gemini} -> {template_gemini}")
    else:
        print_warning(f"[DRY-RUN] Skipped symlinking {target_gemini_file} -> {template_gemini}")

    # 4. MCP Servers Configuration
    if not getattr(args, "no_mcp", False):
        mcp_path = Path(getattr(args, "mcp_path", DEFAULT_MCP_CONFIG_PATH)).expanduser().resolve()
        mcp_catalog = get_standard_mcp_catalog()
        existing_mcp, mcp_exists = load_user_mcp_config(mcp_path)
        merged_mcp, added_mcp = merge_mcp_servers(existing_mcp, mcp_catalog)

        print_step(f"Configuring Standard MCP Servers: {mcp_path}")
        if added_mcp:
            print_info(f"Adding {len(added_mcp)} standard MCP servers:")
            for s in added_mcp:
                print(f"    {GREEN}+{RESET} {s}")
        else:
            print_success("All standard MCP servers are already configured.")

        if not args.dry_run:
            if mcp_exists and not args.no_backup:
                timestamp = datetime.datetime.now().strftime("%Y%m%d_%H%M%S")
                mcp_backup = mcp_path.with_name(f"{mcp_path.name}.bak.{timestamp}")
                shutil.copy2(mcp_path, mcp_backup)
                print_success(f"Created MCP backup: {mcp_backup}")

            save_json(mcp_path, merged_mcp)
            print_success(f"Updated {mcp_path}")
        else:
            print_warning("[DRY-RUN] Skipped writing mcp_config.json updates.")

        # Print Environment Variable Advisories
        mcp_diagnostics = audit_mcp_requirements(mcp_catalog)
        missing_env_advisories = [
            (d["server"], d["missing_env"], d["setup_hint"])
            for d in mcp_diagnostics if d["missing_env"]
        ]
        if missing_env_advisories:
            print_step("Required Environment Variables for Active MCPs")
            for s_name, missing_vars, hint in missing_env_advisories:
                print(f"  {YELLOW}⚠{RESET} {BOLD}{s_name}{RESET} needs: {', '.join(missing_vars)}")
                if hint:
                    print(f"    {CYAN}Advisory:{RESET} {hint}")

    # 5. Standard Plugins Deployment
    if not getattr(args, "no_plugins", False) and PLUGINS_SRC_DIR.exists():
        plugins_dir = Path(getattr(args, "plugins_dir", DEFAULT_GLOBAL_PLUGINS_DIR)).expanduser().resolve()
        print_step(f"Deploying Standard Plugins: {plugins_dir}")
        for plugin_path in sorted(PLUGINS_SRC_DIR.iterdir()):
            if plugin_path.is_dir() and (plugin_path / "plugin.json").exists():
                target_plugin = plugins_dir / plugin_path.name
                if not args.dry_run:
                    target_plugin.mkdir(parents=True, exist_ok=True)
                    for item in plugin_path.rglob("*"):
                        rel_path = item.relative_to(plugin_path)
                        dest = target_plugin / rel_path
                        if item.is_dir():
                            dest.mkdir(parents=True, exist_ok=True)
                        else:
                            shutil.copy2(item, dest)
                            if rel_path.parts and rel_path.parts[0] == "scripts":
                                dest.chmod(dest.stat().st_mode | 0o755)
                    print_success(f"Deployed standard plugin: {plugin_path.name} -> {target_plugin}")
                else:
                    print_warning(f"[DRY-RUN] Skipped deploying plugin {plugin_path.name} -> {target_plugin}")

    # 6. Shell Environment Configuration (~/.bashrc)
    if not getattr(args, "no_env", False):
        bashrc_path = Path(getattr(args, "bashrc_path", DEFAULT_BASHRC_PATH)).expanduser().resolve()
        print_step(f"Configuring Shell Environment: {bashrc_path}")
        changed, msg = configure_bashrc_environment(bashrc_path, dry_run=args.dry_run)
        if changed:
            if not args.dry_run:
                print_success(f"Configured Antigravity environment block in {bashrc_path}")
                dev_db = Path.home() / "dev.db"
                if dev_db.exists():
                    print_success(f"Ensured SQLite dev database initialized at {dev_db}")
            else:
                print_warning(f"[DRY-RUN] Would configure Antigravity environment block in {bashrc_path}")
        else:
            print_success(f"Shell environment block already up to date in {bashrc_path}")

    print(f"\n{BOLD}{GREEN}[SUCCESS]{RESET} Antigravity standardization successfully applied!")
    return 0


def cmd_diff(args: argparse.Namespace) -> int:
    """Show diff between current local settings and standard baseline."""
    settings_path = Path(args.settings_path).expanduser().resolve()
    print(f"\n{BOLD}Diffing Settings against Baseline: {CYAN}{settings_path}{RESET}")

    catalog = get_standard_permissions_catalog()
    standard_permissions = set(get_flat_standard_permissions(catalog))

    existing_settings, exists = load_user_settings(settings_path)
    if not exists:
        print_failure(f"Target settings file not found: {settings_path}")
        return 1

    user_allow = set(existing_settings.get("permissions", {}).get("allow", []))

    missing_standard = sorted(list(standard_permissions - user_allow))
    extra_local = sorted(list(user_allow - standard_permissions))

    if not missing_standard and not extra_local:
        print_success("Local permissions perfectly match the repository baseline.")
        return 0

    if missing_standard:
        print_step(f"Missing Standard Permissions ({len(missing_standard)} commands to be added):")
        for p in missing_standard:
            print(f"  {RED}-{RESET} {p}")

    if extra_local:
        print_step(f"Custom / Machine-Specific Permissions ({len(extra_local)} commands):")
        for p in extra_local:
            print(f"  {GREEN}+{RESET} {p}")

    # MCP Server Diff
    if not getattr(args, "no_mcp", False):
        mcp_path = Path(getattr(args, "mcp_path", DEFAULT_MCP_CONFIG_PATH)).expanduser().resolve()
        mcp_catalog = get_standard_mcp_catalog()
        std_servers = set(mcp_catalog.get("mcpServers", {}).keys())
        existing_mcp, _ = load_user_mcp_config(mcp_path)
        local_servers = set(existing_mcp.get("mcpServers", {}).keys())

        missing_std_mcp = sorted(list(std_servers - local_servers))
        extra_local_mcp = sorted(list(local_servers - std_servers))

        if missing_std_mcp:
            print_step(f"Missing Standard MCP Servers ({len(missing_std_mcp)}):")
            for s in missing_std_mcp:
                print(f"  {RED}-{RESET} {s}")
        if extra_local_mcp:
            print_step(f"Custom / Machine-Specific MCP Servers ({len(extra_local_mcp)}):")
            for s in extra_local_mcp:
                print(f"  {GREEN}+{RESET} {s}")

    return 0


def cmd_snapshot(args: argparse.Namespace) -> int:
    """Export or display unmanaged local permissions and MCP servers for syncing back to git."""
    settings_path = Path(args.settings_path).expanduser().resolve()
    existing_settings, exists = load_user_settings(settings_path)
    if not exists:
        print_failure(f"Settings file not found: {settings_path}")
        return 1

    catalog = get_standard_permissions_catalog()
    standard_permissions = set(get_flat_standard_permissions(catalog))

    user_allow = existing_settings.get("permissions", {}).get("allow", [])
    unmanaged_perms = [p for p in user_allow if p not in standard_permissions]

    unmanaged_mcp = []
    if not getattr(args, "no_mcp", False):
        mcp_path = Path(getattr(args, "mcp_path", DEFAULT_MCP_CONFIG_PATH)).expanduser().resolve()
        mcp_catalog = get_standard_mcp_catalog()
        std_servers = set(mcp_catalog.get("mcpServers", {}).keys())
        existing_mcp, _ = load_user_mcp_config(mcp_path)
        local_servers = set(existing_mcp.get("mcpServers", {}).keys())
        unmanaged_mcp = [s for s in local_servers if s not in std_servers]

    if args.json:
        print(json.dumps({
            "unmanaged_permissions": unmanaged_perms,
            "unmanaged_mcp_servers": unmanaged_mcp,
        }, indent=2))
        return 0

    print(f"\n{BOLD}Snapshot: Unmanaged Local Configurations{RESET}")
    print(f"Settings: {CYAN}{settings_path}{RESET}")

    if not unmanaged_perms:
        print_success("No unmanaged permissions found. Local workstation permissions match baseline.")
    else:
        print_info(f"Found {len(unmanaged_perms)} permissions allowed locally but not in repository:")
        for p in unmanaged_perms:
            print(f"  {CYAN}•{RESET} {p}")

    if not getattr(args, "no_mcp", False):
        if not unmanaged_mcp:
            print_success("No unmanaged MCP servers found. Local workstation MCPs match baseline.")
        else:
            print_info(f"Found {len(unmanaged_mcp)} MCP servers configured locally but not in repository:")
            for s in unmanaged_mcp:
                print(f"  {CYAN}•{RESET} {s}")

    return 0


def cmd_template(args: argparse.Namespace) -> int:
    """Scaffold a project-level GEMINI.md or AGENTS.md."""
    target_dir = Path(args.output).expanduser().resolve()
    target_file = target_dir / "GEMINI.md"
    target_agents = target_dir / "AGENTS.md"

    if target_file.exists() and not args.force:
        print_failure(f"{target_file} already exists. Use --force to overwrite.")
        return 1

    template_src = TEMPLATES_DIR / "project-GEMINI.md"
    if not template_src.exists():
        print_failure(f"Template source missing: {template_src}")
        return 1

    content = template_src.read_text(encoding="utf-8")
    content = content.replace("{{PROJECT_NAME}}", args.name or target_dir.name)
    content = content.replace("{{PROJECT_DESCRIPTION}}", args.desc or "Project-specific developer workspace.")
    content = content.replace("{{PRIMARY_LANGUAGE}}", args.lang or "Python / Polyglot")
    content = content.replace("{{TEST_COMMAND}}", args.test or "python3 -m unittest discover tests -v")

    target_dir.mkdir(parents=True, exist_ok=True)
    target_file.write_text(content, encoding="utf-8")
    print_success(f"Scaffolded project GEMINI.md -> {target_file}")

    # Symlink AGENTS.md
    if target_agents.exists() or target_agents.is_symlink():
        target_agents.unlink()
    target_agents.symlink_to("GEMINI.md")
    print_success(f"Created symlink AGENTS.md -> GEMINI.md in {target_dir}")

    return 0


def cmd_hook_install(args: argparse.Namespace) -> int:
    """Install Conventional Commits commit-msg git hook."""
    target_repo = Path(args.repo).expanduser().resolve()
    git_dir = target_repo / ".git"

    if not git_dir.exists():
        print_failure(f"Not a git repository: {target_repo}")
        return 1

    hook_path = git_dir / "hooks" / "commit-msg"
    hook_script = f"""#!/usr/bin/env python3
# Antigravity Conventional Commits commit-msg Hook
import re
import sys

COMMIT_PATTERN = r"{COMMIT_PATTERN}"

with open(sys.argv[1], 'r', encoding='utf-8') as f:
    lines = [line.strip() for line in f if not line.startswith('#')]

if not lines:
    sys.exit(0)

msg = lines[0]
if not re.match(COMMIT_PATTERN, msg):
    print("\\033[1;31m[ERROR]\\033[0m Invalid Conventional Commit message format:")
    print(f"  Received: '{{msg}}'")
    print("  Expected: <type>(<scope>): <summary>")
    print("  Allowed types: feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert")
    print("  Example: feat(core): implement permissions merger")
    sys.exit(1)
"""

    hook_path.parent.mkdir(parents=True, exist_ok=True)
    hook_path.write_text(hook_script, encoding="utf-8")
    hook_path.chmod(0o755)
    print_success(f"Installed Conventional Commits hook to: {hook_path}")
    return 0


# ==============================================================================
# Main Argument Parser
# ==============================================================================


def main() -> None:
    parser = argparse.ArgumentParser(
        prog="agy-standardise",
        description="Standardize Antigravity CLI permissions, agent directives, and workstation configs.",
    )
    subparsers = parser.add_subparsers(dest="subcommand", help="Available subcommands")

    # audit
    p_audit = subparsers.add_parser("audit", help="Audit local Antigravity CLI configuration against standards")
    p_audit.add_argument("--settings-path", default=str(DEFAULT_SETTINGS_PATH), help="Path to settings.json")
    p_audit.add_argument("--mcp-path", default=str(DEFAULT_MCP_CONFIG_PATH), help="Path to mcp_config.json")
    p_audit.add_argument("--plugins-dir", default=str(DEFAULT_GLOBAL_PLUGINS_DIR), help="Path to plugins directory")
    p_audit.add_argument("--gemini-dir", default=str(DEFAULT_GLOBAL_GEMINI_DIR), help="Path to .gemini directory")
    p_audit.add_argument("--bashrc-path", default=str(DEFAULT_BASHRC_PATH), help="Path to .bashrc file")
    p_audit.add_argument("--no-mcp", action="store_true", help="Skip MCP server checks")
    p_audit.add_argument("--no-plugins", action="store_true", help="Skip plugin checks")
    p_audit.add_argument("--no-env", action="store_true", help="Skip shell environment checks")
    p_audit.add_argument("-v", "--verbose", action="store_true", help="Show detailed breakdown of all checks")
    p_audit.set_defaults(func=cmd_audit)

    # apply / configure
    p_apply = subparsers.add_parser("apply", aliases=["configure"], help="Apply standards to local workstation")
    p_apply.add_argument("--settings-path", default=str(DEFAULT_SETTINGS_PATH), help="Path to settings.json")
    p_apply.add_argument("--mcp-path", default=str(DEFAULT_MCP_CONFIG_PATH), help="Path to mcp_config.json")
    p_apply.add_argument("--plugins-dir", default=str(DEFAULT_GLOBAL_PLUGINS_DIR), help="Path to plugins directory")
    p_apply.add_argument("--gemini-dir", default=str(DEFAULT_GLOBAL_GEMINI_DIR), help="Path to .gemini directory")
    p_apply.add_argument("--bashrc-path", default=str(DEFAULT_BASHRC_PATH), help="Path to .bashrc file")
    p_apply.add_argument("--no-mcp", action="store_true", help="Skip MCP server configuration")
    p_apply.add_argument("--no-plugins", action="store_true", help="Skip plugin deployment")
    p_apply.add_argument("--no-env", action="store_true", help="Skip shell environment configuration")
    p_apply.add_argument("--dry-run", action="store_true", help="Simulate changes without writing to disk")
    p_apply.add_argument("--no-backup", action="store_true", help="Do not create backup before writing")
    p_apply.add_argument("--link-home", action="store_true", help="Also symlink GEMINI.md into $HOME")
    p_apply.set_defaults(func=cmd_apply)

    # diff
    p_diff = subparsers.add_parser("diff", help="Diff local settings against standard permissions baseline")
    p_diff.add_argument("--settings-path", default=str(DEFAULT_SETTINGS_PATH), help="Path to settings.json")
    p_diff.add_argument("--mcp-path", default=str(DEFAULT_MCP_CONFIG_PATH), help="Path to mcp_config.json")
    p_diff.add_argument("--no-mcp", action="store_true", help="Skip MCP server diffing")
    p_diff.set_defaults(func=cmd_diff)

    # snapshot / export
    p_snap = subparsers.add_parser("snapshot", aliases=["export"], help="Inspect or export unmanaged local permissions")
    p_snap.add_argument("--settings-path", default=str(DEFAULT_SETTINGS_PATH), help="Path to settings.json")
    p_snap.add_argument("--mcp-path", default=str(DEFAULT_MCP_CONFIG_PATH), help="Path to mcp_config.json")
    p_snap.add_argument("--no-mcp", action="store_true", help="Skip MCP server snapshot")
    p_snap.add_argument("--json", action="store_true", help="Output results in JSON format")
    p_snap.set_defaults(func=cmd_snapshot)

    # template
    p_tmpl = subparsers.add_parser("template", help="Scaffold project-level GEMINI.md rules")
    p_tmpl.add_argument("--output", default=".", help="Target project directory")
    p_tmpl.add_argument("--name", help="Project name")
    p_tmpl.add_argument("--desc", help="Project description")
    p_tmpl.add_argument("--lang", help="Primary language / framework")
    p_tmpl.add_argument("--test", help="Test command")
    p_tmpl.add_argument("-f", "--force", action="store_true", help="Overwrite existing GEMINI.md")
    p_tmpl.set_defaults(func=cmd_template)

    # hook
    p_hook = subparsers.add_parser("hook", help="Git hook management")
    hook_sub = p_hook.add_subparsers(dest="hook_command")
    p_hook_inst = hook_sub.add_parser("install", help="Install Conventional Commits hook")
    p_hook_inst.add_argument("--repo", default=".", help="Target git repository path")
    p_hook_inst.set_defaults(func=cmd_hook_install)

    args = parser.parse_args()
    if not hasattr(args, "func"):
        parser.print_help()
        sys.exit(1)

    sys.exit(args.func(args))


if __name__ == "__main__":
    main()
