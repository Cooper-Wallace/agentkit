    p_v_note.add_argument("--tag", action="append", help="Tag to attach to note (can be specified multiple times)")
    p_v_note.add_argument("--section", help="Optional section heading to append into project note directly")
    p_v_note.add_argument("--json", action="store_true", help="Output note creation details in JSON format")
    p_v_note.set_defaults(func=cmd_vault_note)

    p_vault.set_defaults(func=_print_subparser_help(p_vault))

