#!/usr/bin/env python3
"""
agentkit: Harness-agnostic AI agent configuration, permissions, directives, and orchestration toolkit.

Features:
- Audit AI harness settings, command permissions, global agent directives, and multi-model orchestration profiles.
- Safely merge standard pre-approved commands into settings without overwriting custom rules or workspaces.
- Automated backup creation (settings.json.bak.<timestamp>) and full --dry-run support.
- Snapshot / export locally approved commands and MCP servers back to repository manifests.
- Diff local machine state against standardized declarative catalog.
- Scaffold project-level AGENTS.md / GEMINI.md rulesets into repositories.
- Configure multi-model orchestration tiers (Argon-Flash, Opus-Flash, Sonnet-Flash, Pro-Flash).
- Modular Harness abstraction supporting Google Antigravity, Claude Code, Cursor, and OpenCode.
- Install local Conventional Commits git hooks.
- Manage reusable project skills (list, inspect info, and install via symlink or copy).
- Discover and list reusable project utility tools and scripts.
"""

import argparse
import datetime
import difflib
import json
import os
import re
import shutil
import sys
from abc import ABC, abstractmethod
from pathlib import Path
from typing import Any, Dict, List, Optional, Set, Tuple, Type

# Terminal colors and formatting
GREEN = "\033[1;32m"
RED = "\033[1;31m"
YELLOW = "\033[1;33m"
BLUE = "\033[1;34m"
CYAN = "\033[1;36m"
BOLD = "\033[1m"
RESET = "\033[0m"

# Project root and directory resolution
SCRIPT_DIR = Path(__file__).resolve().parent
REPO_ROOT = SCRIPT_DIR.parent
CONFIG_DIR = REPO_ROOT / "config"
HARNESS_DIR = REPO_ROOT / "harness"
PROJECT_DIR = REPO_ROOT / "project"
PLUGINS_SRC_DIR = HARNESS_DIR / "plugins"
TEMPLATES_DIR = PROJECT_DIR / "templates"
GLOBAL_DIRECTIVES_SRC = HARNESS_DIR / "rules" / "AGENTS.md"
PROJECT_SKILLS_DIR = PROJECT_DIR / "skills"
PROJECT_TOOLS_DIR = PROJECT_DIR / "tools"
PERMISSIONS_FILE = CONFIG_DIR / "permissions.json"
SETTINGS_DEFAULT_FILE = CONFIG_DIR / "settings.default.json"
ORCHESTRATION_FILE = CONFIG_DIR / "orchestration.json"
MCP_CATALOG_FILE = CONFIG_DIR / "mcp.json"

DEFAULT_SETTINGS_PATH = Path.home() / ".gemini" / "antigravity-cli" / "settings.json"
DEFAULT_GLOBAL_GEMINI_DIR = Path.home() / ".gemini"
DEFAULT_MCP_CONFIG_PATH = Path.home() / ".gemini" / "config" / "mcp_config.json"
DEFAULT_GLOBAL_PLUGINS_DIR = Path.home() / ".gemini" / "config" / "plugins"

# Conventional commit regex pattern (aligning with repokit)
COMMIT_PATTERN = (
    r"^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)"
    r"(\([a-zA-Z0-9_\-\.]+\))?!?: .+$"
)


# ==============================================================================
# Modular Harness Abstraction
# ==============================================================================


class HarnessAdapter(ABC):
    """Abstract base adapter for AI development harnesses."""

    name: str = "base"
    display_name: str = "Base Harness"

    @abstractmethod
    def get_default_settings_path(self) -> Path:
        """Return the default path to settings/config file."""
        raise NotImplementedError

    @abstractmethod
    def get_default_mcp_path(self) -> Path:
        """Return the default path to MCP servers configuration."""
        raise NotImplementedError

    @abstractmethod
    def get_default_plugins_dir(self) -> Path:
        """Return the default plugins directory."""
        raise NotImplementedError

    @abstractmethod
    def get_default_directives_dir(self) -> Path:
        """Return the default global directives directory."""
        raise NotImplementedError

    @abstractmethod
    def get_default_orchestration_path(self) -> Path:
        """Return the default orchestration configuration file path."""
        raise NotImplementedError

    def get_directive_filenames(self) -> List[str]:
        """Return ordered list of directive filenames (primary first)."""
        return ["AGENTS.md", "GEMINI.md"]


class AntigravityHarnessAdapter(HarnessAdapter):
    """Google Antigravity CLI harness adapter."""

    name: str = "antigravity"
    display_name: str = "Google Antigravity"

    def get_default_settings_path(self) -> Path:
        return Path.home() / ".gemini" / "antigravity-cli" / "settings.json"

    def get_default_mcp_path(self) -> Path:
        return Path.home() / ".gemini" / "config" / "mcp_config.json"

    def get_default_plugins_dir(self) -> Path:
        return Path.home() / ".gemini" / "config" / "plugins"

    def get_default_directives_dir(self) -> Path:
        return Path.home() / ".gemini"

    def get_default_orchestration_path(self) -> Path:
        return Path.home() / ".gemini" / "config" / "orchestration.json"

    def get_directive_filenames(self) -> List[str]:
        return ["AGENTS.md", "GEMINI.md"]


