    p_wake = subparsers.add_parser(
        "wake",
        aliases=["wakelock"],
        parents=[harness_parent],
        help="Agent sleep prevention & ambient wake-lock indicator",
    )
    wake_sub = p_wake.add_subparsers(dest="wake_command", help="Wake subcommands")

    # wake status
    p_w_status = wake_sub.add_parser("status", parents=[harness_parent], help="Fetch and print sleep wake status")
    p_w_status.add_argument("--json", action="store_true", help="Output JSON status")
    p_w_status.set_defaults(func=cmd_wake_status)

    # wake daemon
    p_w_daemon = wake_sub.add_parser("daemon", parents=[harness_parent], help="Start wake server daemon")
    p_w_daemon.add_argument("--port", type=int, default=18820, help="Daemon port")
    p_w_daemon.add_argument("--foreground", action="store_true", help="Run in foreground")
    p_w_daemon.set_defaults(func=cmd_wake_daemon)

    # wake tray
    p_w_tray = wake_sub.add_parser("tray", parents=[harness_parent], help="Start system tray indicator")
    p_w_tray.add_argument("--embed-engine", action="store_true", help="Embed daemon server inside tray process")
    p_w_tray.set_defaults(func=cmd_wake_tray)

    # wake notify
    p_w_notify = wake_sub.add_parser("notify", parents=[harness_parent], help="Ping wake server with active/idle state")
    p_w_notify.add_argument("state", choices=["active", "idle"], help="Execution state")
    p_w_notify.add_argument("--session", default=os.environ.get("ANTIGRAVITY_SESSION_ID", "default"), help="Session ID")
    p_w_notify.add_argument("--agent", default=os.environ.get("AGENTKIT_HARNESS", "agent"), help="Agent name")
    p_w_notify.add_argument("--task", default="", help="Task description")
    p_w_notify.add_argument("--quiet", action="store_true", help="Suppress output")
    p_w_notify.set_defaults(func=cmd_wake_notify)

    # wake watch
    p_w_watch = wake_sub.add_parser("watch", parents=[harness_parent], help="Live terminal ANSI loop of wake status")
    p_w_watch.set_defaults(func=cmd_wake_watch)

    # wake autostart
    p_w_autostart = wake_sub.add_parser("autostart", parents=[harness_parent], help="Manage system startup autostart entry")
    p_w_autostart.add_argument("--enable", action="store_true", help="Enable autostart")
    p_w_autostart.add_argument("--disable", action="store_true", help="Disable autostart")
    p_w_autostart.add_argument("--status", action="store_true", help="Check autostart status")
    p_w_autostart.set_defaults(func=cmd_wake_autostart)

    # wake override
    p_w_override = wake_sub.add_parser("override", parents=[harness_parent], help="Toggle manual sleep inhibition override")
    p_w_override.add_argument("--on", action="store_true", help="Enable manual override")
    p_w_override.add_argument("--off", action="store_true", help="Disable manual override")
    p_w_override.set_defaults(func=cmd_wake_override)

    # wake log
    p_w_log = wake_sub.add_parser("log", parents=[harness_parent], help="Read and print session history journal")
    p_w_log.add_argument("--limit", type=int, default=50, help="Number of recent log lines")
    p_w_log.set_defaults(func=cmd_wake_log)

    p_wake.set_defaults(func=_print_subparser_help(p_wake))

    return parser


def main() -> None:
    parser = build_parser()
    args = parser.parse_args()
    if not hasattr(args, "func"):
        parser.print_help()
        sys.exit(1)

    sys.exit(args.func(args))


if __name__ == "__main__":
    main()
