DEPRECATED_PROFILE_ALIASES = {"pro-flash": "flash-high"}
DEFAULT_COMPLEXITY_TIERS = {
    "low": {
        "model": "flash_lite",
        "use": "file moves/renames, mechanical find-replace, formatting, doc typos, run one command and summarize",
    },
    "med": {"model": "flash", "use": "feature code, tests, localized refactors"},
    "high": {
        "model": "flash",
        "escalate_to": "pro",
        "use": "cross-module refactors, debugging, security, architecture; pro only for review/architecture/debugging when Argon quota healthy",
    },
}
QUOTA_SCRIPT = HARNESS_DIR / "plugins" / "quota-guardian" / "scripts" / "quota_status.py"


def get_orchestration_catalog() -> Dict[str, Any]:
    """Load declarative multi-model orchestration catalog."""
    if ORCHESTRATION_FILE.exists():
        try:
            return load_json(ORCHESTRATION_FILE)
        except Exception:
            pass
    tl = json.loads(json.dumps(DEFAULT_COMPLEXITY_TIERS))
    return {
        "default_profile": "argon-flash",
        "deprecated_aliases": dict(DEPRECATED_PROFILE_ALIASES),
        "profiles": {
            "argon-flash": {
                "description": "Gemini 4 Argon Root Orchestrator (complex tasks) -> Gemini 3.8 Flash Worker Subagents (Default tier)",
                "root_model": "Gemini 4 Argon",
                "worker_model": "flash",
                "root_slug": "argon",
                "complexity_tiers": tl,
                "quota_fallback": ["flash-high", "opus-flash", "sonnet-flash"],
            },
            "flash-high": {
                "description": "Gemini 3.8 Flash (HIGH reasoning) Root Orchestrator -> Gemini 3.8 Flash Worker Subagents (Standard tier)",
                "root_model": "Gemini 3.8 Flash (high reasoning)",
                "worker_model": "flash",
                "root_slug": "flash-high",
                "complexity_tiers": tl,
                "quota_fallback": ["opus-flash", "sonnet-flash"],
            },
            "opus-flash": {
                "description": "Claude Opus 5.5 Root Orchestrator -> Gemini 3.8 Flash Worker Subagents (Quota/token limit fallback tier)",
                "root_model": "Claude Opus 5.5",
                "worker_model": "flash",
                "root_slug": "opus",
                "complexity_tiers": tl,
                "quota_fallback": ["sonnet-flash"],
            },
            "sonnet-flash": {
                "description": "Claude Sonnet 3.7 Root Orchestrator -> Gemini 3.8 Flash Worker Subagents (High-throughput engineering tier)",
                "root_model": "Claude Sonnet 3.7",
                "worker_model": "flash",
                "root_slug": "sonnet",
                "complexity_tiers": tl,
                "quota_fallback": ["opus-flash"],
            },
        },
    }


def list_model_profiles() -> List[str]:
    """Return available orchestration model profile slugs."""
    cat = get_orchestration_catalog()
    profiles = list(cat.get("profiles", {}).keys())
    return profiles or ["argon-flash", "flash-high", "opus-flash", "sonnet-flash"]


def profile_arg(value: str) -> str:
    """argparse type: map deprecated profile aliases (e.g. pro-flash) to their replacement with a warning."""
    aliases = get_orchestration_catalog().get("deprecated_aliases", DEPRECATED_PROFILE_ALIASES)
    if value in aliases:
        print(
            f"WARNING: model profile '{value}' is deprecated (base model retired); using '{aliases[value]}'.",
            file=sys.stderr,
        )
        return aliases[value]
    return value


def _profile_lines(name: str, info: Dict[str, Any], default: str) -> List[str]:
    mark = " (default)" if name == default else ""
    lines = [
        f"{BOLD}{name}{RESET}{mark}: {info.get('description', '')}",
        f"    root: {info.get('root_model', 'N/A')} | worker: {info.get('worker_model', 'N/A')}",
        "    complexity_tiers:",
    ]
    tiers = info.get("complexity_tiers") or info.get("thinking_levels", {})  # old key kept for compat
    for lvl, t in tiers.items():
        if isinstance(t, str):
            t = {"use": t}
        esc = f" (escalate to {t['escalate_to']})" if t.get("escalate_to") else ""
        lines.append(f"      {lvl}: {t.get('model', info.get('worker_model', 'N/A'))}{esc} - {t.get('use', '')}")
    lines.append(f"    fallback: {' -> '.join(info.get('quota_fallback', [])) or 'none'}")
    return lines


def cmd_profile_list(args: argparse.Namespace) -> int:
    cat = get_orchestration_catalog()
    default = cat.get("default_profile", "argon-flash")
    for name, info in cat.get("profiles", {}).items():
        print("\n".join(_profile_lines(name, info, default)))
    return 0


def cmd_profile_show(args: argparse.Namespace) -> int:
    cat = get_orchestration_catalog()
    name = args.profile_name
    info = cat.get("profiles", {}).get(name)
    if info is None:
        print_failure(f"Unknown profile: {name}")
        return 1
    print("\n".join(_profile_lines(name, info, cat.get("default_profile", "argon-flash"))))
    return 0


def _run_quota_script(script_args: List[str]) -> int:
    """Delegate to the quota-guardian plugin script via subprocess (never imported)."""
    if not QUOTA_SCRIPT.exists():
        print(f"quota-guardian plugin script not found: {QUOTA_SCRIPT}", file=sys.stderr)
        print("Install or restore harness/plugins/quota-guardian to use quota commands.", file=sys.stderr)
        return 1
    import subprocess

    return subprocess.run([sys.executable, str(QUOTA_SCRIPT)] + script_args).returncode


def cmd_quota_status(args: argparse.Namespace) -> int:
    return _run_quota_script(["status"] + (["--json"] if args.json else []))


def cmd_quota_route(args: argparse.Namespace) -> int:
    return _run_quota_script(["route", "--complexity", args.complexity] + (["--json"] if args.json else []))


def resolve_orchestration_config_path(
    args: argparse.Namespace, harness: HarnessAdapter
) -> Path:
    """Resolve target path for orchestration.json."""
    if getattr(args, "orchestration_path", None):
        return Path(args.orchestration_path).expanduser().resolve()
    if getattr(args, "gemini_dir", None):
        return Path(args.gemini_dir).expanduser().resolve() / "config" / "orchestration.json"
    return harness.get_default_orchestration_path()


# ==============================================================================
# Commands
# ==============================================================================


def cmd_audit(args: argparse.Namespace) -> int:
    """Audit the current machine's AI harness configuration against standards."""
    harness = get_harness_adapter(getattr(args, "harness", "antigravity"))
    settings_path = (
        Path(args.settings_path).expanduser().resolve()
        if getattr(args, "settings_path", None)
        else harness.get_default_settings_path()
    )

    print(f"\n{BOLD}Auditing {harness.display_name} Standards via agentkit{RESET}")
    print(f"Harness: {CYAN}{harness.name}{RESET}")
    print(f"Target Settings: {CYAN}{settings_path}{RESET}")

    total_checks = 0
    passed_checks = 0

    catalog = get_standard_permissions_catalog()
    standard_permissions = get_flat_standard_permissions(catalog)

    # 1. Settings File Existence Check
    total_checks += 1
    settings, exists = load_user_settings(settings_path)
    if exists:
        print_success(f"Settings file exists ({settings_path})")
        passed_checks += 1
    else:
        print_failure(f"Settings file missing ({settings_path})")

    # 2. Permissions Allow List
    user_allow = []
    if exists and "permissions" in settings and isinstance(settings["permissions"], dict):
        user_allow = settings["permissions"].get("allow", [])
        if not isinstance(user_allow, list):
            user_allow = []

    user_allow_set = set(user_allow)
    missing_permissions = [p for p in standard_permissions if p not in user_allow_set]
    active_permissions = [p for p in standard_permissions if p in user_allow_set]

    total_checks += 1
    if not missing_permissions:
        print_success(
            f"Standard Permissions: All {len(standard_permissions)} pre-approved permissions active "
            f"({len(active_permissions)}/{len(standard_permissions)} active)"
        )
        passed_checks += 1
    else:
        print_failure(
            f"Standard Permissions: {len(missing_permissions)} of {len(standard_permissions)} permissions missing "
            f"({len(active_permissions)}/{len(standard_permissions)} active)"
        )
        if args.verbose:
            print(f"    {YELLOW}Missing permissions:{RESET}")
            for p in missing_permissions:
                print(f"      - {p}")

    # Category and Tool Breakdown (when verbose)
    if args.verbose:
        print_step("Command Categories")
        for cat_name, cat_data in catalog.get("categories", {}).items():
            cat_cmds = [f"command({c})" for c in cat_data.get("commands", [])]
            cat_present = [p for p in cat_cmds if p in user_allow_set]
            status_color = GREEN if len(cat_present) == len(cat_cmds) else YELLOW
            print(f"  {status_color}•{RESET} {BOLD}{cat_name}{RESET} ({len(cat_present)}/{len(cat_cmds)} active)")

        print_step("MCP & Provisioned Tool Permissions")
        for mcp_name, mcp_data in catalog.get("mcp_tools", {}).items():
            mcp_perms = mcp_data.get("permissions", []) if isinstance(mcp_data, dict) else mcp_data
            mcp_present = [p for p in mcp_perms if p in user_allow_set]
            status_color = GREEN if len(mcp_present) == len(mcp_perms) else YELLOW
            print(f"  {status_color}•{RESET} {BOLD}{mcp_name}{RESET} ({len(mcp_present)}/{len(mcp_perms)} active)")

        for tool_name, tool_data in catalog.get("tools", {}).items():
            tool_perms = tool_data.get("permissions", []) if isinstance(tool_data, dict) else tool_data
            tool_present = [p for p in tool_perms if p in user_allow_set]
            status_color = GREEN if len(tool_present) == len(tool_perms) else YELLOW
            print(f"  {status_color}•{RESET} {BOLD}{tool_name}{RESET} ({len(tool_present)}/{len(tool_perms)} active)")

        print_step("Native File Access Permissions")
        for fa_name, fa_data in catalog.get("file_access", {}).items():
            fa_perms = [
                p.replace("${HOME}", str(Path.home())).replace("$HOME", str(Path.home()))
                for p in (fa_data.get("permissions", []) if isinstance(fa_data, dict) else fa_data)
            ]
            fa_present = [p for p in fa_perms if p in user_allow_set]
            status_color = GREEN if len(fa_present) == len(fa_perms) else YELLOW
            print(f"  {status_color}•{RESET} {BOLD}{fa_name}{RESET} ({len(fa_present)}/{len(fa_perms)} active)")

        print(f"\n  {BOLD}Total Active Permissions:{RESET} {len(active_permissions)}/{len(standard_permissions)} active")

    # 3. Global Agent Directives Check (AGENTS.md and GEMINI.md)
    total_checks += 1
    target_gemini_dir = (
        Path(getattr(args, "gemini_dir", None)).expanduser().resolve()
        if getattr(args, "gemini_dir", None)
        else harness.get_default_directives_dir()
    )
    global_agents = target_gemini_dir / "AGENTS.md"
    global_gemini = target_gemini_dir / "GEMINI.md"

    if global_agents.exists() or global_gemini.exists():
        target_found = global_agents if global_agents.exists() else global_gemini
        print_success(f"Global Agent Directives installed ({target_found})")
        passed_checks += 1
    else:
        print_failure(f"Global Agent Directives missing ({global_agents})")

    # 4. Non-workspace access setting
    total_checks += 1
    if settings.get("allowNonWorkspaceAccess") is True:
        print_success("Workspace Boundary: 'allowNonWorkspaceAccess' enabled")
        passed_checks += 1
    else:
        print_warning("Workspace Boundary: 'allowNonWorkspaceAccess' not explicitly enabled")

    # 5. Trusted Workspaces (AgentVault, agentkit, repokit) Check
    total_checks += 1
    user_workspaces = settings.get("trustedWorkspaces", [])
    if not isinstance(user_workspaces, list):
        user_workspaces = []

    expected_vault_paths = {
        str(Path.home() / "Documents" / "AgentVault"),
        str(Path.home() / "AgentVault"),
    }
    for env_var in ("AGENTKIT_VAULT_PATH", "AGENTKIT_AGENTVAULT_PATH"):
        env_val = os.environ.get(env_var)
        if env_val and env_val.strip():
            expected_vault_paths.add(str(Path(env_val).expanduser().resolve()))

    agentkit_path = str(Path.home() / "Projects" / "agentkit")
    repokit_path = str(Path.home() / "Projects" / "repokit")

    found_vault_paths = [w for w in user_workspaces if w in expected_vault_paths]
    has_vault = bool(found_vault_paths)
    has_agentkit = agentkit_path in user_workspaces
    has_repokit = repokit_path in user_workspaces

    if has_vault and has_agentkit and has_repokit:
        print_success("Trusted Workspaces: AgentVault, agentkit, and repokit whitelisted")
        passed_checks += 1
    else:
        missing_workspaces = []
        if not has_vault:
            missing_workspaces.append(f"AgentVault ({str(Path.home() / 'Documents' / 'AgentVault')})")
        if not has_agentkit:
            missing_workspaces.append(f"agentkit ({agentkit_path})")
        if not has_repokit:
            missing_workspaces.append(f"repokit ({repokit_path})")
        print_warning(
            f"Trusted Workspaces: Required workspace path(s) missing from trustedWorkspaces ({', '.join(missing_workspaces)})"
        )

    # 6. Native File Access Permissions (AgentVault, agentkit, repokit) Check
    total_checks += 1
    expected_read_vault = {
        f"read_file({str(Path.home() / 'Documents' / 'AgentVault')})",
        f"read_file({str(Path.home() / 'AgentVault')})",
    }
    for env_var in ("AGENTKIT_VAULT_PATH", "AGENTKIT_AGENTVAULT_PATH"):
        env_val = os.environ.get(env_var)
        if env_val and env_val.strip():
            expected_read_vault.add(f"read_file({str(Path(env_val).expanduser().resolve())})")

    agentkit_read = f"read_file({str(Path.home() / 'Projects' / 'agentkit')})"
    repokit_read = f"read_file({str(Path.home() / 'Projects' / 'repokit')})"

    has_read_vault = bool([p for p in expected_read_vault if p in user_allow_set])
    has_read_agentkit = agentkit_read in user_allow_set
    has_read_repokit = repokit_read in user_allow_set

    if has_read_vault and has_read_agentkit and has_read_repokit:
        print_success("Native File Access: AgentVault, agentkit, and repokit read permissions active")
        passed_checks += 1
    else:
        missing_file_perms = []
        if not has_read_vault:
            missing_file_perms.append(f"AgentVault (read_file({str(Path.home() / 'Documents' / 'AgentVault')}))")
        if not has_read_agentkit:
            missing_file_perms.append(f"agentkit ({agentkit_read})")
        if not has_read_repokit:
            missing_file_perms.append(f"repokit ({repokit_read})")
        print_warning(
            f"Native File Access: Required read_file permission(s) missing from permissions.allow ({', '.join(missing_file_perms)})"
        )

    # 7. Color Scheme Check
    total_checks += 1
    if settings.get("colorScheme") == "dark":
        print_success("UI Theme: 'colorScheme' set to 'dark'")
        passed_checks += 1
    else:
        print_info(f"UI Theme: 'colorScheme' is '{settings.get('colorScheme', 'not set')}'")
        passed_checks += 1

    # 8. PATH verification for ~/.local/bin
    total_checks += 1
    local_bin = str(Path.home() / ".local" / "bin")
    current_path = os.environ.get("PATH", "")
    if f":{local_bin}:" in f":{current_path}:":
        print_success(f"Environment PATH includes {local_bin}")
        passed_checks += 1
    else:
        print_warning(f"Environment PATH missing {local_bin}")

    # 9. MCP Server Standards & Environment Diagnostics
    if not getattr(args, "no_mcp", False):
        mcp_path = (
            Path(getattr(args, "mcp_path", None)).expanduser().resolve()
            if getattr(args, "mcp_path", None)
            else harness.get_default_mcp_path()
        )
        mcp_catalog = get_standard_mcp_catalog()
        std_servers = mcp_catalog.get("mcpServers", {})

        total_checks += 1
        user_mcp, mcp_exists = load_user_mcp_config(mcp_path)
        configured_servers = user_mcp.get("mcpServers", {})
        missing_mcp = [s for s in std_servers.keys() if s not in configured_servers]

        if not missing_mcp:
            print_success(f"MCP Configuration: All {len(std_servers)} standard servers configured ({mcp_path})")
            passed_checks += 1
        else:
            print_failure(
                f"MCP Configuration: {len(missing_mcp)} of {len(std_servers)} standard servers missing ({', '.join(missing_mcp)})"
            )

        # Environment & Binary Diagnostics
        mcp_diagnostics = audit_mcp_requirements(mcp_catalog)
        missing_env_advisories = []
        for diag in mcp_diagnostics:
            s_name = diag["server"]
            if diag["ready"]:
                if args.verbose:
                    print_success(f"MCP '{s_name}': Dependencies and environment ready")
            else:
                if diag["missing_bins"]:
                    print_warning(f"MCP '{s_name}': Missing required binary in PATH: {', '.join(diag['missing_bins'])}")
                if diag["missing_env"]:
                    print_warning(f"MCP '{s_name}': Missing environment variable: {', '.join(diag['missing_env'])}")
                    if diag["setup_hint"]:
                        missing_env_advisories.append((s_name, diag["setup_hint"]))

        if missing_env_advisories and args.verbose:
            print_step("MCP Environment Setup Advisories")
            for s_name, hint in missing_env_advisories:
                print(f"  {CYAN}ℹ{RESET} {BOLD}{s_name}{RESET}: {hint}")

    # 10. Standard Plugins Audit
    if not getattr(args, "no_plugins", False):
        plugins_dir = (
            Path(getattr(args, "plugins_dir", None)).expanduser().resolve()
            if getattr(args, "plugins_dir", None)
            else harness.get_default_plugins_dir()
        )
        if PLUGINS_SRC_DIR.exists():
            for plugin_path in sorted(PLUGINS_SRC_DIR.iterdir()):
                if plugin_path.is_dir() and (plugin_path / "plugin.json").exists():
                    total_checks += 1
                    target_plugin = plugins_dir / plugin_path.name
                    target_manifest = target_plugin / "plugin.json"
                    if target_manifest.exists():
                        scripts_dir = target_plugin / "scripts"
                        all_executable = True
                        if scripts_dir.exists():
                            for script in scripts_dir.iterdir():
                                if script.is_file() and not os.access(script, os.X_OK):
                                    all_executable = False
                        if all_executable:
                            print_success(f"Plugin '{plugin_path.name}' installed and operational ({target_plugin})")
                            passed_checks += 1
                        else:
                            print_warning(f"Plugin '{plugin_path.name}' scripts missing executable permission (+x)")
                            passed_checks += 1
                    else:
                        print_failure(f"Plugin '{plugin_path.name}' missing ({target_plugin})")

    # 11. Multi-Model Orchestration Profile Audit
    total_checks += 1
    orch_catalog = get_orchestration_catalog()
    configured_profile: Optional[str] = None

    if exists:
        configured_profile = settings.get("orchestrationProfile") or (
            settings.get("orchestration", {}).get("profile")
            if isinstance(settings.get("orchestration"), dict)
            else None
        )

    orch_path = resolve_orchestration_config_path(args, harness)
    if not configured_profile and orch_path.exists():
        try:
            orch_data = load_json(orch_path)
            configured_profile = orch_data.get("active_profile")
        except Exception:
            pass

    if configured_profile:
        prof_info = orch_catalog.get("profiles", {}).get(configured_profile, {})
        prof_desc = prof_info.get("description", configured_profile)
        print_success(f"Orchestration Profile: '{configured_profile}' active ({prof_desc})")
        passed_checks += 1
    else:
        print_warning(
            f"Orchestration Profile: No profile explicitly recorded (default fallback: {getattr(args, 'model_profile', 'argon-flash')})"
        )

    # Summary
    print("\n" + "─" * 60)
    score_pct = int((passed_checks / total_checks) * 100) if total_checks else 0
    if passed_checks == total_checks:
        print(
            f"{BOLD}{GREEN}[SUCCESS]{RESET} {harness.display_name} configuration is fully compliant! "
            f"({passed_checks}/{total_checks} checks passed)"
        )
        return 0
    else:
        print(
            f"{BOLD}{YELLOW}[NON-COMPLIANT]{RESET} Compliance score: {score_pct}% "
            f"({passed_checks}/{total_checks} checks passed)."
        )
        print(f"Run {BOLD}agentkit apply{RESET} to bring your workstation into compliance.")
        return 1


def cmd_apply(args: argparse.Namespace) -> int:
    """Apply standard permissions, MCP servers, plugins, directives, and orchestration profiles."""
    harness = get_harness_adapter(getattr(args, "harness", "antigravity"))
    settings_path = (
        Path(args.settings_path).expanduser().resolve()
        if getattr(args, "settings_path", None)
        else harness.get_default_settings_path()
    )
    print_step(f"Applying {harness.display_name} Standards via agentkit: {settings_path}")

    catalog = get_standard_permissions_catalog()
    standard_permissions = get_flat_standard_permissions(catalog)
    default_settings = load_json(SETTINGS_DEFAULT_FILE) if SETTINGS_DEFAULT_FILE.exists() else {}

    existing_settings, exists = load_user_settings(settings_path)
    merged_settings, added = merge_permissions(existing_settings, standard_permissions, default_settings)

    # 1. Show permission additions
    if added:
        print_info(f"Adding {len(added)} missing standard permissions:")
        for perm in added:
            print(f"    {GREEN}+{RESET} {perm}")
    else:
        print_success("All standard permissions are already present.")

    # 2. Multi-Model Orchestration Profile
    model_profile = getattr(args, "model_profile", "argon-flash")
    orch_catalog = get_orchestration_catalog()
    profile_info = orch_catalog.get("profiles", {}).get(model_profile, {})
    profile_desc = profile_info.get("description", model_profile)

    print_step(f"Configuring Orchestration Profile: {BOLD}{model_profile}{RESET}")
    print_info(f"Tier: {profile_desc}")
    print_info(f"Root: {profile_info.get('root_model', 'N/A')} | Worker: {profile_info.get('worker_model', 'N/A')}")

    merged_settings["orchestrationProfile"] = model_profile
    merged_settings["orchestration"] = {
        "profile": model_profile,
        "description": profile_desc,
        "root_model": profile_info.get("root_model", ""),
        "worker_model": profile_info.get("worker_model", ""),
        "root_slug": profile_info.get("root_slug", ""),
    }

    # 3. Backup and Write Settings
    if not args.dry_run:
        if exists and not args.no_backup:
            timestamp = datetime.datetime.now().strftime("%Y%m%d_%H%M%S")
            backup_path = settings_path.with_name(f"{settings_path.name}.bak.{timestamp}")
            shutil.copy2(settings_path, backup_path)
            print_success(f"Created backup: {backup_path}")

        save_json(settings_path, merged_settings)
        print_success(f"Updated {settings_path}")
    else:
        print_warning("[DRY-RUN] Skipped writing settings.json updates.")

    # 4. Harness Orchestration JSON Record
    orch_path = resolve_orchestration_config_path(args, harness)
    if not args.dry_run:
        orch_record = {
            "active_profile": model_profile,
            "updated_at": datetime.datetime.now().isoformat(),
            "profile": profile_info,
        }
        try:
            save_json(orch_path, orch_record)
            print_success(f"Recorded active orchestration profile in: {orch_path}")
        except Exception as e:
            print_warning(f"Could not record orchestration config at {orch_path}: {e}")
    else:
        print_warning(f"[DRY-RUN] Skipped writing orchestration profile to {orch_path}")

    # 5. Global AGENTS.md / GEMINI.md Directives Linking
    if not GLOBAL_DIRECTIVES_SRC.exists():
        print_failure(f"Global directives not found at: {GLOBAL_DIRECTIVES_SRC}")
        return 1

    target_gemini_dir = (
        Path(getattr(args, "gemini_dir", None)).expanduser().resolve()
        if getattr(args, "gemini_dir", None)
        else harness.get_default_directives_dir()
    )
    target_agents_file = target_gemini_dir / "AGENTS.md"
    target_gemini_file = target_gemini_dir / "GEMINI.md"

    if not args.dry_run:
        target_gemini_dir.mkdir(parents=True, exist_ok=True)

        if target_agents_file.exists() or target_agents_file.is_symlink():
            target_agents_file.unlink()
        target_agents_file.symlink_to(GLOBAL_DIRECTIVES_SRC)
        print_success(f"Linked global directives: {target_agents_file} -> {GLOBAL_DIRECTIVES_SRC}")

        if target_gemini_file.exists() or target_gemini_file.is_symlink():
            target_gemini_file.unlink()
        target_gemini_file.symlink_to(GLOBAL_DIRECTIVES_SRC)
        print_success(f"Linked global directives: {target_gemini_file} -> {GLOBAL_DIRECTIVES_SRC}")

        if args.link_home:
            home_agents = Path.home() / "AGENTS.md"
            home_gemini = Path.home() / "GEMINI.md"
            for h_file in (home_agents, home_gemini):
                if h_file.exists() or h_file.is_symlink():
                    h_file.unlink()
                h_file.symlink_to(GLOBAL_DIRECTIVES_SRC)
                print_success(f"Linked home directives: {h_file} -> {GLOBAL_DIRECTIVES_SRC}")
    else:
        print_warning(f"[DRY-RUN] Skipped symlinking directives in {target_gemini_dir} -> {GLOBAL_DIRECTIVES_SRC}")

    # 6. MCP Servers Configuration
    if not getattr(args, "no_mcp", False):
        mcp_path = (
            Path(getattr(args, "mcp_path", None)).expanduser().resolve()
            if getattr(args, "mcp_path", None)
            else harness.get_default_mcp_path()
        )
        mcp_catalog = get_standard_mcp_catalog()
        existing_mcp, mcp_exists = load_user_mcp_config(mcp_path)
        merged_mcp, added_mcp = merge_mcp_servers(existing_mcp, mcp_catalog)

        print_step(f"Configuring Standard MCP Servers: {mcp_path}")
        if added_mcp:
            print_info(f"Adding {len(added_mcp)} standard MCP servers:")
            for s in added_mcp:
                print(f"    {GREEN}+{RESET} {s}")
        else:
            print_success("All standard MCP servers are already configured.")

        if not args.dry_run:
            if mcp_exists and not args.no_backup:
                timestamp = datetime.datetime.now().strftime("%Y%m%d_%H%M%S")
                mcp_backup = mcp_path.with_name(f"{mcp_path.name}.bak.{timestamp}")
                shutil.copy2(mcp_path, mcp_backup)
                print_success(f"Created MCP backup: {mcp_backup}")

            save_json(mcp_path, merged_mcp)
            print_success(f"Updated {mcp_path}")
        else:
            print_warning("[DRY-RUN] Skipped writing mcp_config.json updates.")

        # Print Environment Variable Advisories
        mcp_diagnostics = audit_mcp_requirements(mcp_catalog)
        missing_env_advisories = [
            (d["server"], d["missing_env"], d["setup_hint"])
            for d in mcp_diagnostics
            if d["missing_env"]
        ]
        if missing_env_advisories:
            print_step("Required Environment Variables for Active MCPs")
            for s_name, missing_vars, hint in missing_env_advisories:
                print(f"  {YELLOW}⚠{RESET} {BOLD}{s_name}{RESET} needs: {', '.join(missing_vars)}")
                if hint:
                    print(f"    {CYAN}Advisory:{RESET} {hint}")

    # 7. Standard Plugins Deployment
    if not getattr(args, "no_plugins", False) and PLUGINS_SRC_DIR.exists():
        plugins_dir = (
            Path(getattr(args, "plugins_dir", None)).expanduser().resolve()
            if getattr(args, "plugins_dir", None)
            else harness.get_default_plugins_dir()
        )
        print_step(f"Deploying Standard Plugins: {plugins_dir}")
        for plugin_path in sorted(PLUGINS_SRC_DIR.iterdir()):
            if plugin_path.is_dir() and (plugin_path / "plugin.json").exists():
                target_plugin = plugins_dir / plugin_path.name
                if not args.dry_run:
                    target_plugin.mkdir(parents=True, exist_ok=True)
                    for item in plugin_path.rglob("*"):
                        rel_path = item.relative_to(plugin_path)
                        dest = target_plugin / rel_path
                        if item.is_dir():
                            dest.mkdir(parents=True, exist_ok=True)
                        else:
                            shutil.copy2(item, dest)
                            if rel_path.parts and rel_path.parts[0] == "scripts":
                                dest.chmod(dest.stat().st_mode | 0o755)
                    print_success(f"Deployed standard plugin: {plugin_path.name} -> {target_plugin}")
                else:
                    print_warning(f"[DRY-RUN] Skipped deploying plugin {plugin_path.name} -> {target_plugin}")

    # 8. AgentKit Wake Autostart Configuration
    if not getattr(args, "no_wake_autostart", False):
        from project.tools.wake.autostart import enable_autostart, is_autostart_enabled
        if not is_autostart_enabled():
            if not args.dry_run:
                ok, msg = enable_autostart()
                if ok:
                    print_success(f"Configured agentkit wake autostart: {msg}")
                else:
                    print_warning(f"Could not configure agentkit wake autostart: {msg}")
            else:
                print_warning("[DRY-RUN] Skipped enabling agentkit wake autostart.")
        else:
            print_success("AgentKit Wake autostart is already configured.")

    print(f"\n{BOLD}{GREEN}[SUCCESS]{RESET} {harness.display_name} standardization successfully applied!")
    print_info(f"Active orchestration profile: {BOLD}{model_profile}{RESET} ({profile_desc})")
    return 0


def cmd_diff(args: argparse.Namespace) -> int:
    """Show diff between current local settings and standard baseline."""
    harness = get_harness_adapter(getattr(args, "harness", "antigravity"))
    settings_path = (
        Path(args.settings_path).expanduser().resolve()
        if getattr(args, "settings_path", None)
        else harness.get_default_settings_path()
    )
    print(f"\n{BOLD}Diffing Settings against Baseline: {CYAN}{settings_path}{RESET}")

    catalog = get_standard_permissions_catalog()
    standard_permissions = set(get_flat_standard_permissions(catalog))

    existing_settings, exists = load_user_settings(settings_path)
    if not exists:
        print_failure(f"Target settings file not found: {settings_path}")
        return 1

    user_allow = set(existing_settings.get("permissions", {}).get("allow", []))

    missing_standard = sorted(list(standard_permissions - user_allow))
    extra_local = sorted(list(user_allow - standard_permissions))

    if not missing_standard and not extra_local:
        print_success("Local permissions perfectly match the repository baseline.")
        return 0

    if missing_standard:
        print_step(f"Missing Standard Permissions ({len(missing_standard)} permissions to be added):")
        for p in missing_standard:
            print(f"  {RED}-{RESET} {p}")

    if extra_local:
        print_step(f"Custom / Machine-Specific Permissions ({len(extra_local)} permissions):")
        for p in extra_local:
            print(f"  {GREEN}+{RESET} {p}")

    # MCP Server Diff
    if not getattr(args, "no_mcp", False):
        mcp_path = (
            Path(getattr(args, "mcp_path", None)).expanduser().resolve()
            if getattr(args, "mcp_path", None)
            else harness.get_default_mcp_path()
        )
        mcp_catalog = get_standard_mcp_catalog()
        std_servers = set(mcp_catalog.get("mcpServers", {}).keys())
        existing_mcp, _ = load_user_mcp_config(mcp_path)
        local_servers = set(existing_mcp.get("mcpServers", {}).keys())

        missing_std_mcp = sorted(list(std_servers - local_servers))
        extra_local_mcp = sorted(list(local_servers - std_servers))

        if missing_std_mcp:
            print_step(f"Missing Standard MCP Servers ({len(missing_std_mcp)}):")
            for s in missing_std_mcp:
                print(f"  {RED}-{RESET} {s}")
        if extra_local_mcp:
            print_step(f"Custom / Machine-Specific MCP Servers ({len(extra_local_mcp)}):")
            for s in extra_local_mcp:
                print(f"  {GREEN}+{RESET} {s}")

    return 0


def cmd_snapshot(args: argparse.Namespace) -> int:
    """Export or display unmanaged local permissions and MCP servers for syncing back to git."""
    harness = get_harness_adapter(getattr(args, "harness", "antigravity"))
    settings_path = (
        Path(args.settings_path).expanduser().resolve()
        if getattr(args, "settings_path", None)
        else harness.get_default_settings_path()
    )
    existing_settings, exists = load_user_settings(settings_path)
    if not exists:
        print_failure(f"Settings file not found: {settings_path}")
        return 1

    catalog = get_standard_permissions_catalog()
    standard_permissions = set(get_flat_standard_permissions(catalog))

    user_allow = existing_settings.get("permissions", {}).get("allow", [])
    unmanaged_perms = [p for p in user_allow if p not in standard_permissions]

    unmanaged_mcp = []
    if not getattr(args, "no_mcp", False):
        mcp_path = (
            Path(getattr(args, "mcp_path", None)).expanduser().resolve()
            if getattr(args, "mcp_path", None)
            else harness.get_default_mcp_path()
        )
        mcp_catalog = get_standard_mcp_catalog()
        std_servers = set(mcp_catalog.get("mcpServers", {}).keys())
        existing_mcp, _ = load_user_mcp_config(mcp_path)
        local_servers = set(existing_mcp.get("mcpServers", {}).keys())
        unmanaged_mcp = [s for s in local_servers if s not in std_servers]

    if args.json:
        print(json.dumps({
            "unmanaged_permissions": unmanaged_perms,
            "unmanaged_mcp_servers": unmanaged_mcp,
        }, indent=2))
        return 0

    print(f"\n{BOLD}Snapshot: Unmanaged Local Configurations{RESET}")
    print(f"Settings: {CYAN}{settings_path}{RESET}")

    if not unmanaged_perms:
        print_success("No unmanaged permissions found. Local workstation permissions match baseline.")
    else:
        print_info(f"Found {len(unmanaged_perms)} permissions allowed locally but not in repository:")
        for p in unmanaged_perms:
            print(f"  {CYAN}•{RESET} {p}")

    if not getattr(args, "no_mcp", False):
        if not unmanaged_mcp:
            print_success("No unmanaged MCP servers found. Local workstation MCPs match baseline.")
        else:
            print_info(f"Found {len(unmanaged_mcp)} MCP servers configured locally but not in repository:")
            for s in unmanaged_mcp:
                print(f"  {CYAN}•{RESET} {s}")

    return 0


def cmd_template(args: argparse.Namespace) -> int:
    """Scaffold a project-level AGENTS.md or GEMINI.md."""
    target_dir = Path(args.output).expanduser().resolve()
    legacy_mode = getattr(args, "legacy", False)

    if legacy_mode:
        primary_name = "GEMINI.md"
        secondary_name = "AGENTS.md"
    else:
        primary_name = "AGENTS.md"
        secondary_name = "GEMINI.md"

    primary_file = target_dir / primary_name
    secondary_file = target_dir / secondary_name

    if primary_file.exists() and not args.force:
        print_failure(f"{primary_file} already exists. Use --force to overwrite.")
        return 1

    template_src = TEMPLATES_DIR / "AGENTS.md"
    if not template_src.exists():
        template_src = TEMPLATES_DIR / f"project-{primary_name}"
    if not template_src.exists():
        template_src = TEMPLATES_DIR / "project-GEMINI.md"
    if not template_src.exists():
        template_src = TEMPLATES_DIR / "project-AGENTS.md"
    if not template_src.exists():
        print_failure(f"Template source missing in: {TEMPLATES_DIR}")
        return 1

    content = template_src.read_text(encoding="utf-8")
    content = content.replace("{{PROJECT_NAME}}", args.name or target_dir.name)
    content = content.replace("{{PROJECT_DESCRIPTION}}", args.desc or "Project-specific developer workspace.")
    content = content.replace("{{PRIMARY_LANGUAGE}}", args.lang or "Python / Polyglot")
    content = content.replace("{{TEST_COMMAND}}", args.test or "python3 -m unittest discover tests -v")

    target_dir.mkdir(parents=True, exist_ok=True)
    primary_file.write_text(content, encoding="utf-8")
    print_success(f"Scaffolded project {primary_name} -> {primary_file}")

    # Symlink secondary to primary
    if secondary_file.exists() or secondary_file.is_symlink():
        secondary_file.unlink()
    secondary_file.symlink_to(primary_name)
    print_success(f"Created symlink {secondary_name} -> {primary_name} in {target_dir}")

    return 0


def cmd_hook_install(args: argparse.Namespace) -> int:
    """Install Conventional Commits commit-msg git hook."""
    target_repo = Path(args.repo).expanduser().resolve()
    git_dir = target_repo / ".git"

    if not git_dir.exists():
        print_failure(f"Not a git repository: {target_repo}")
        return 1

    hook_path = git_dir / "hooks" / "commit-msg"
    hook_script = f"""#!/usr/bin/env python3
# Conventional Commits commit-msg Hook (managed by agentkit)
import re
import sys

COMMIT_PATTERN = r"{COMMIT_PATTERN}"

with open(sys.argv[1], 'r', encoding='utf-8') as f:
    lines = [line.strip() for line in f if not line.startswith('#')]

if not lines:
    sys.exit(0)

msg = lines[0]
if not re.match(COMMIT_PATTERN, msg):
    print("\\033[1;31m[ERROR]\\033[0m Invalid Conventional Commit message format:")
    print(f"  Received: '{{msg}}'")
    print("  Expected: <type>(<scope>): <summary>")
    print("  Allowed types: feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert")
    print("  Example: feat(core): implement permissions merger")
    sys.exit(1)
"""

    hook_path.parent.mkdir(parents=True, exist_ok=True)
    hook_path.write_text(hook_script, encoding="utf-8")
    hook_path.chmod(0o755)
    print_success(f"Installed Conventional Commits hook to: {hook_path}")
    return 0


# ==============================================================================
# Skill & Tool Management Helpers
# ==============================================================================


def parse_skill_md(skill_path: Path) -> Dict[str, Any]:
    """Parse frontmatter and content from a SKILL.md file."""
    if not skill_path.exists():
        return {}
    content = skill_path.read_text(encoding="utf-8")
    metadata: Dict[str, Any] = {}
    body = content

    if content.startswith("---"):
        parts = content.split("---", 2)
        if len(parts) >= 3:
            raw_frontmatter = parts[1].strip()
            body = parts[2].strip()
            for line in raw_frontmatter.splitlines():
                line = line.strip()
                if not line or line.startswith("#"):
                    continue
                if ":" in line:
                    key, val = line.split(":", 1)
                    metadata[key.strip()] = val.strip().strip("\"'")

    title = metadata.get("name") or ""
    for line in body.splitlines():
        line = line.strip()
        if line.startswith("# "):
            title = line[2:].strip()
            break
    if not metadata.get("title"):
        metadata["title"] = title

    metadata["body"] = body
    return metadata


def extract_script_description(script_path: Path) -> str:
    """Extract description or docstring from a script file."""
    try:
        content = script_path.read_text(encoding="utf-8", errors="replace")
    except Exception:
        return "No description available."

    lines = content.splitlines()
    desc_lines: List[str] = []

    if script_path.suffix == ".py":
        import ast

        try:
            tree = ast.parse(content)
            doc = ast.get_docstring(tree)
            if doc:
                return doc.strip().split("\n\n")[0].replace("\n", " ").strip()
        except Exception:
            pass

    in_comment_block = False
    for line in lines:
        line_s = line.strip()
        if line_s.startswith("#!"):
            continue
        if line_s.startswith("#"):
            comment_text = line_s.lstrip("#").strip()
            if comment_text:
                desc_lines.append(comment_text)
                in_comment_block = True
            elif in_comment_block:
                break
        elif in_comment_block:
            break
        elif line_s:
            break

    if desc_lines:
        return " ".join(desc_lines)
    return "No description available."


def cmd_skill_list(args: argparse.Namespace) -> int:
    """List available reusable project skills."""
    print(f"\n{BOLD}Available Project Skills ({PROJECT_SKILLS_DIR}):{RESET}\n")
    if not PROJECT_SKILLS_DIR.exists():
        print_info(f"Skills directory missing: {PROJECT_SKILLS_DIR}")
        return 0

    skills: List[Dict[str, Any]] = []
    for entry in sorted(PROJECT_SKILLS_DIR.iterdir()):
        skill_file = entry / "SKILL.md"
        if entry.is_dir() and skill_file.exists():
            meta = parse_skill_md(skill_file)
            skills.append({
                "dir_name": entry.name,
                "name": meta.get("name") or entry.name,
                "description": meta.get("description") or "No description provided.",
                "title": meta.get("title") or entry.name,
            })

    if not skills:
        print_info(f"No reusable skills found in {PROJECT_SKILLS_DIR}.")
        return 0

    max_name = max(len(s["name"]) for s in skills)
    for s in skills:
        print(f"  {BOLD}{CYAN}{s['name'].ljust(max_name + 2)}{RESET} {s['description']}")

    print(f"\nRun {BOLD}agentkit skill info <skill_name>{RESET} for detailed instructions.")
    return 0


def cmd_skill_info(args: argparse.Namespace) -> int:
    """Display title, description, and instructions from <skill_dir>/SKILL.md."""
    skill_name = args.skill_name
    skill_dir = PROJECT_SKILLS_DIR / skill_name
    skill_file = skill_dir / "SKILL.md"

    if not skill_file.exists() and PROJECT_SKILLS_DIR.exists():
        for entry in PROJECT_SKILLS_DIR.iterdir():
            candidate = entry / "SKILL.md"
            if entry.is_dir() and candidate.exists():
                meta = parse_skill_md(candidate)
                if meta.get("name") == skill_name:
                    skill_dir = entry
                    skill_file = candidate
                    break

    if not skill_file.exists():
        print_failure(f"Skill '{skill_name}' not found in {PROJECT_SKILLS_DIR}")
        return 1

    meta = parse_skill_md(skill_file)
    name = meta.get("name") or skill_dir.name
    title = meta.get("title") or name
    description = meta.get("description") or "No description provided."
    body = meta.get("body", "")

    print(f"\n{BOLD}{CYAN}Skill:{RESET} {BOLD}{name}{RESET}")
    print(f"{BOLD}Title:{RESET} {title}")
    print(f"{BOLD}Path:{RESET}  {skill_dir}")
    print(f"{BOLD}Description:{RESET}\n  {description}\n")
    print(f"{BOLD}Instructions & Reference:{RESET}")
    print("─" * 60)
    print(body)
    print("─" * 60)
    return 0


def cmd_skill_install(args: argparse.Namespace) -> int:
    """Install a skill into a project directory."""
    skill_name = args.skill_name
    skill_dir = PROJECT_SKILLS_DIR / skill_name
    skill_file = skill_dir / "SKILL.md"

    if not skill_file.exists() and PROJECT_SKILLS_DIR.exists():
        for entry in PROJECT_SKILLS_DIR.iterdir():
            candidate = entry / "SKILL.md"
            if entry.is_dir() and candidate.exists():
                meta = parse_skill_md(candidate)
                if meta.get("name") == skill_name:
                    skill_dir = entry
                    skill_file = candidate
                    break

    if not skill_dir.exists() or not skill_file.exists():
        print_failure(f"Skill '{skill_name}' not found at: {PROJECT_SKILLS_DIR}")
        return 1

    target_arg = getattr(args, "target", None)
    if target_arg:
        target_path = Path(os.path.abspath(os.path.expanduser(target_arg)))
        if target_path.is_dir() and not target_path.is_symlink() and target_path.name != skill_dir.name and not (target_path / "SKILL.md").exists():
            target_path = target_path / skill_dir.name
    else:
        target_path = Path(os.path.abspath(Path.cwd() / "skills" / skill_dir.name))

    # Guard against targeting the source skill directory itself
    if target_path == skill_dir or (target_path.exists() and not target_path.is_symlink() and target_path.resolve() == skill_dir.resolve()):
        print_info(f"Skill '{skill_name}' is already located at {target_path}")
        return 0

    mode_str = "copy" if getattr(args, "copy", False) else "symlink"
    print_step(f"Installing skill '{skill_name}' via {mode_str} -> {target_path}")

    if not getattr(args, "copy", False):
        try:
            rel_target = os.path.relpath(skill_dir, target_path.parent)
        except ValueError:
            rel_target = str(skill_dir)

        if target_path.is_symlink():
            try:
                current_target = os.readlink(target_path)
                if current_target == rel_target or target_path.resolve() == skill_dir.resolve():
                    print_success(f"Skill '{skill_name}' is already installed at {target_path}")
                    return 0
            except OSError:
                pass

        if not args.dry_run:
            target_path.parent.mkdir(parents=True, exist_ok=True)
            if target_path.is_symlink() or target_path.exists():
                if target_path.is_dir() and not target_path.is_symlink():
                    shutil.rmtree(target_path)
                else:
                    target_path.unlink()
            target_path.symlink_to(rel_target)
            print_success(f"Linked skill: {target_path} -> {rel_target}")
        else:
            print_warning(f"[DRY-RUN] Skipped symlinking {target_path} -> {rel_target}")
    else:
        if not args.dry_run:
            target_path.parent.mkdir(parents=True, exist_ok=True)
            if target_path.is_symlink():
                target_path.unlink()
            shutil.copytree(skill_dir, target_path, dirs_exist_ok=True)
            print_success(f"Copied skill: {skill_dir} -> {target_path}")
        else:
            print_warning(f"[DRY-RUN] Skipped copying {skill_dir} -> {target_path}")

    return 0


def cmd_tool_list(args: argparse.Namespace) -> int:
    """List available project utility tools."""
    print(f"\n{BOLD}Available Project Utility Tools ({PROJECT_TOOLS_DIR}):{RESET}\n")
    if not PROJECT_TOOLS_DIR.exists():
        print_info(f"Tools directory missing: {PROJECT_TOOLS_DIR}")
        return 0

    tools: List[Tuple[str, str, Path]] = []
    for entry in sorted(PROJECT_TOOLS_DIR.iterdir()):
        if entry.is_file() and entry.name != ".gitkeep":
            desc = extract_script_description(entry)
            tools.append((entry.name, desc, entry))
        elif entry.is_dir() and not entry.name.startswith(".") and not entry.name.startswith("_"):
            tool_script = entry / f"{entry.name}.py"
            if not tool_script.exists():
                tool_script = entry / f"{entry.name}.sh"
            if not tool_script.exists():
                tool_script = entry / "main.py"
            desc = extract_script_description(tool_script) if tool_script.exists() else "Tool package."
            tools.append((entry.name, desc, entry))

    if not tools:
        print_info(f"No utility tools found in {PROJECT_TOOLS_DIR}.")
        return 0

    max_name_len = max(len(t[0]) for t in tools)
    for name, desc, _ in tools:
        print(f"  {BOLD}{CYAN}{name.ljust(max_name_len + 2)}{RESET} {desc}")

    return 0


def _print_subparser_help(parser_obj: argparse.ArgumentParser):
    """Return a callback that prints help for the given subparser and returns 0."""
    def _func(args: argparse.Namespace) -> int:
        parser_obj.print_help()
        return 0
    return _func


# ==============================================================================
# Obsidian Vault CLI Engine & Knowledge Graph Integration
# ==============================================================================

DEFAULT_VAULT_PATH = Path.home() / "Documents" / "AgentVault"


def resolve_vault_path(explicit_path: Optional[str] = None) -> Path:
    """Resolve Obsidian vault root path from CLI args, environment variables, or standard default."""
    if explicit_path:
        return Path(explicit_path).expanduser().resolve()
    env = os.environ.get("AGENTKIT_VAULT_PATH") or os.environ.get("AGENTKIT_AGENTVAULT_PATH") or os.environ.get("OBSIDIAN_VAULT_PATH")
    if env:
        return Path(env).expanduser().resolve()
    return DEFAULT_VAULT_PATH.resolve()


def parse_frontmatter_and_body(text: str) -> Tuple[Dict[str, Any], str]:
    """Parse YAML frontmatter and markdown body."""
    if not text.startswith("---"):
        return {}, text
    parts = text.split("---", 2)
    if len(parts) < 3:
        return {}, text
    raw_fm = parts[1].strip()
    body = parts[2].lstrip("\n")
    meta: Dict[str, Any] = {}
    current_key: Optional[str] = None
    for line in raw_fm.splitlines():
        line_str = line.strip()
        if not line_str or line_str.startswith("#"):
            continue
        if line_str.startswith("- ") and current_key:
            val = line_str[2:].strip()
            if not isinstance(meta.get(current_key), list):
                meta[current_key] = []
            meta[current_key].append(val)
        elif ":" in line:
            k, v = line.split(":", 1)
            k = k.strip()
            v = v.strip()
            current_key = k
            if v:
                meta[k] = v
            else:
                meta[k] = []
        else:
            current_key = None
    return meta, body


def format_frontmatter(
    tags: List[str],
    note_type: str,
    updated_by: str = "agentkit",
    extra: Optional[Dict[str, Any]] = None,
) -> str:
    """Format clean YAML frontmatter with tags, type, last_updated, and updated_by."""
    today_iso = datetime.date.today().isoformat()
    lines = ["---"]
    if tags:
        lines.append("tags:")
        for t in tags:
            lines.append(f"  - {t}")
    lines.append(f"type: {note_type}")
    lines.append(f"last_updated: {today_iso}")
    lines.append(f"updated_by: {updated_by}")
    if extra:
        for k, v in extra.items():
            if k in ("tags", "type", "last_updated", "updated_by"):
                continue
            if isinstance(v, list):
                lines.append(f"{k}:")
                for item in v:
                    lines.append(f"  - {item}")
            else:
                lines.append(f"{k}: {v}")
    lines.append("---")
    return "\n".join(lines)


def write_vault_note_if_missing(file_path: Path, content: str) -> bool:
    """Write content to file_path if it doesn't already exist. Returns True if created."""
    if file_path.exists():
        return False
    file_path.parent.mkdir(parents=True, exist_ok=True)
    file_path.write_text(content, encoding="utf-8")
    return True


