SUPPORTED_HARNESSES: Dict[str, Type[HarnessAdapter]] = {
    "antigravity": AntigravityHarnessAdapter,
    "claude-code": ClaudeCodeHarnessAdapter,
    "cursor": CursorHarnessAdapter,
    "opencode": OpenCodeHarnessAdapter,
}


def get_harness_adapter(name: str = "antigravity") -> HarnessAdapter:
    """Instantiate and return adapter for requested harness name."""
    adapter_cls = SUPPORTED_HARNESSES.get(name)
    if not adapter_cls:
        raise ValueError(
            f"Unsupported harness: '{name}'. Supported: {', '.join(SUPPORTED_HARNESSES.keys())}"
        )
    return adapter_cls()


# ==============================================================================
# UI Formatting & Logging
# ==============================================================================


def print_step(title: str) -> None:
    print(f"\n{BOLD}{BLUE}==>{RESET} {BOLD}{title}{RESET}")


def print_success(msg: str) -> None:
    print(f"  {GREEN}✔{RESET} {msg}")


def print_failure(msg: str) -> None:
    print(f"  {RED}✖{RESET} {msg}")


def print_warning(msg: str) -> None:
    print(f"  {YELLOW}⚠{RESET} {msg}")


def print_info(msg: str) -> None:
    print(f"  {CYAN}ℹ{RESET} {msg}")


# ==============================================================================
# JSON File Helpers & Catalogs
# ==============================================================================


def load_json(path: Path) -> Dict[str, Any]:
    """Load and parse a JSON file."""
    with open(path, "r", encoding="utf-8") as f:
        return json.load(f)


def save_json(path: Path, data: Dict[str, Any]) -> None:
    """Save dictionary to a formatted JSON file."""
    path.parent.mkdir(parents=True, exist_ok=True)
    with open(path, "w", encoding="utf-8") as f:
        json.dump(data, f, indent=2, ensure_ascii=False)
        f.write("\n")


def get_standard_permissions_catalog() -> Dict[str, Any]:
    """Load standard permissions catalog from repository config."""
    if not PERMISSIONS_FILE.exists():
        raise FileNotFoundError(f"Missing permissions catalog at: {PERMISSIONS_FILE}")
    return load_json(PERMISSIONS_FILE)


def get_flat_standard_permissions(catalog: Optional[Dict[str, Any]] = None) -> List[str]:
    """Extract flat list of standardized permission strings from catalog."""
    if catalog is None:
        catalog = get_standard_permissions_catalog()

    permissions: List[str] = []

    # Command categories -> command(<cmd>)
    for cat_data in catalog.get("categories", {}).values():
        for cmd in cat_data.get("commands", []):
            perm_str = f"command({cmd})"
            if perm_str not in permissions:
                permissions.append(perm_str)

    # MCP tools -> strings in permissions list
    for mcp_data in catalog.get("mcp_tools", {}).values():
        perm_list = mcp_data.get("permissions", []) if isinstance(mcp_data, dict) else mcp_data
        for perm in perm_list:
            if perm not in permissions:
                permissions.append(perm)

    # Core/provisioned harness tools -> strings in permissions list
    for tool_data in catalog.get("tools", {}).values():
        perm_list = tool_data.get("permissions", []) if isinstance(tool_data, dict) else tool_data
        for perm in perm_list:
            if perm not in permissions:
                permissions.append(perm)

    return permissions


def load_user_settings(settings_path: Path) -> Tuple[Dict[str, Any], bool]:
    """Load user settings.json. Returns (dict, file_exists)."""
    if not settings_path.exists():
        return {}, False
    try:
        return load_json(settings_path), True
    except json.JSONDecodeError as err:
        raise ValueError(f"Corrupted JSON in {settings_path}: {err}")


def merge_permissions(
    existing_settings: Dict[str, Any],
    standard_permissions: List[str],
    default_settings: Optional[Dict[str, Any]] = None,
) -> Tuple[Dict[str, Any], List[str]]:
    """
    Idempotently merge standard permissions into existing settings.
    Preserves custom permissions, trusted workspaces, and user preferences.
    Returns (merged_settings_dict, list_of_newly_added_permissions).
    """
    result = dict(existing_settings)

    # Apply default baseline settings if missing
    if default_settings:
        for key, value in default_settings.items():
            if key not in result:
                result[key] = value

    if "permissions" not in result or not isinstance(result["permissions"], dict):
        result["permissions"] = {}

    current_allow: List[str] = result["permissions"].get("allow", [])
    if not isinstance(current_allow, list):
        current_allow = []

    current_set: Set[str] = set(current_allow)
    added_permissions: List[str] = []

    merged_allow = list(current_allow)
    for perm in standard_permissions:
        if perm not in current_set:
            merged_allow.append(perm)
            added_permissions.append(perm)
            current_set.add(perm)

    result["permissions"]["allow"] = merged_allow

    # Ensure trustedWorkspaces exists as a list if not already present
    if "trustedWorkspaces" not in result:
        result["trustedWorkspaces"] = []

    return result, added_permissions


def get_standard_mcp_catalog() -> Dict[str, Any]:
    """Load standard MCP catalog from repository config."""
    if not MCP_CATALOG_FILE.exists():
        return {"mcpServers": {}, "_requirements": {}}
    return load_json(MCP_CATALOG_FILE)


def load_user_mcp_config(mcp_path: Path) -> Tuple[Dict[str, Any], bool]:
    """Load user mcp_config.json. Returns (dict, file_exists)."""
    if not mcp_path.exists():
        return {"mcpServers": {}}, False
    try:
        data = load_json(mcp_path)
        if "mcpServers" not in data or not isinstance(data["mcpServers"], dict):
            data["mcpServers"] = {}
        return data, True
    except json.JSONDecodeError as err:
        raise ValueError(f"Corrupted JSON in {mcp_path}: {err}")


def resolve_mcp_server_vars(
    srv_def: Dict[str, Any],
    resolve_env: bool = False,
) -> Dict[str, Any]:
    """
    Resolve environment variable placeholders in MCP server definitions.
    Interpolates ${VAR} or ${VAR:-default} in args (and optionally env).
    - If os.environ.get(var_name) is present and non-empty, uses its value.
    - Else if a default is provided (${VAR:-default}), expands $HOME/~ if present and uses the default.
    - Else if var_name == "SQLITE_DEV_DB", defaults to str(Path.home() / "dev.db").
    - Otherwise, preserves the placeholder.
    """
    if not srv_def or not isinstance(srv_def, dict):
        return {}
    var_pattern = re.compile(r"\$\{([A-Za-z_][A-Za-z0-9_]*)(?::-([^}]*))?\}")

    def _replace_match(match: re.Match) -> str:
        var_name = match.group(1)
        default_val = match.group(2)
        env_val = os.environ.get(var_name)
        if env_val:
            return env_val
        if default_val is not None:
            if "$HOME" in default_val:
                default_val = default_val.replace("$HOME", str(Path.home()))
            elif "${HOME}" in default_val:
                default_val = default_val.replace("${HOME}", str(Path.home()))
            elif default_val.startswith("~"):
                default_val = str(Path.home()) + default_val[1:]
            return default_val
        if var_name == "SQLITE_DEV_DB":
            return str(Path.home() / "dev.db")
        return match.group(0)

    def _interpolate(val: Any) -> Any:
        if isinstance(val, str):
            return var_pattern.sub(_replace_match, val)
        return val

    resolved = dict(srv_def)
    if "command" in resolved and isinstance(resolved["command"], str):
        resolved["command"] = _interpolate(resolved["command"])
    if "args" in resolved and isinstance(resolved["args"], list):
        resolved["args"] = [_interpolate(arg) for arg in resolved["args"]]
    if resolve_env and "env" in resolved and isinstance(resolved["env"], dict):
        resolved["env"] = {k: _interpolate(v) for k, v in resolved["env"].items()}
    return resolved


def merge_mcp_servers(
    existing_mcp: Dict[str, Any],
    standard_catalog: Dict[str, Any],
) -> Tuple[Dict[str, Any], List[str]]:
    """
    Idempotently merge standard MCP servers into existing mcp_config.json.
    Preserves custom/local MCP servers.
    Resolves environment variable placeholders (e.g. ${SQLITE_DEV_DB}) in args.
    Returns (merged_dict, list_of_newly_added_server_keys).
    """
    result = dict(existing_mcp)
    if "mcpServers" not in result or not isinstance(result["mcpServers"], dict):
        result["mcpServers"] = {}

    current_servers = dict(result["mcpServers"])
    standard_servers = standard_catalog.get("mcpServers", {})
    added_servers: List[str] = []

    for name, srv_def in standard_servers.items():
        if name not in current_servers:
            current_servers[name] = resolve_mcp_server_vars(srv_def)
            added_servers.append(name)
        else:
            # If standard server already exists, heal any unexpanded placeholders
            # (e.g. literal '${SQLITE_DEV_DB}' created prior to interpolation support)
            resolved = resolve_mcp_server_vars(current_servers[name])
            if resolved != current_servers[name]:
                current_servers[name] = resolved

    result["mcpServers"] = current_servers
    return result, added_servers


def is_env_var_configured(var_name: str) -> bool:
    """Return True if var_name is in os.environ or exported in ~/.profile or ~/.bashrc."""
    if bool(os.environ.get(var_name)):
        return True

    pattern = f"export {var_name}="
    for path in (Path.home() / ".profile", Path.home() / ".bashrc"):
        if path.exists():
            try:
                if pattern in path.read_text(encoding="utf-8"):
                    return True
            except Exception:
                pass
    return False


def audit_mcp_requirements(
    mcp_catalog: Dict[str, Any],
) -> List[Dict[str, Any]]:
    """
    Inspect the host environment against MCP requirements.
    Checks required binaries (via shutil.which) and required environment variables (via is_env_var_configured).
    Returns list of requirement status dicts.
    """
    diagnostics = []
    requirements = mcp_catalog.get("_requirements", {})
    standard_servers = mcp_catalog.get("mcpServers", {})

    for server_name in standard_servers.keys():
        req = requirements.get(server_name, {})
        desc = req.get("description", "")
        required_bins = req.get("required_bins", [])
        required_env = req.get("required_env", [])
        setup_hint = req.get("setup_hint", "")

        missing_bins = [b for b in required_bins if shutil.which(b) is None]
        missing_env = [v for v in required_env if not is_env_var_configured(v)]

        diagnostics.append({
            "server": server_name,
            "description": desc,
            "required_bins": required_bins,
            "missing_bins": missing_bins,
            "required_env": required_env,
            "missing_env": missing_env,
            "setup_hint": setup_hint,
            "ready": len(missing_bins) == 0 and len(missing_env) == 0,
        })
    return diagnostics


