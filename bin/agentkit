def cmd_vault_init(args: argparse.Namespace) -> int:
    """Idempotently initialize Obsidian vault directory tree, Dashboard, and initial projects."""
    vault_path = resolve_vault_path(getattr(args, "path", None))
    print_step(f"Initializing Obsidian AgentVault at {vault_path}")

    # 1. Directories
    vault_path.mkdir(parents=True, exist_ok=True)
    (vault_path / ".obsidian").mkdir(exist_ok=True)
    (vault_path / "00-Inbox").mkdir(exist_ok=True)
    (vault_path / "User-Input" / "pending").mkdir(parents=True, exist_ok=True)
    (vault_path / "User-Input" / "processed").mkdir(parents=True, exist_ok=True)
    (vault_path / "Projects").mkdir(exist_ok=True)
    (vault_path / "Architecture" / "decisions").mkdir(parents=True, exist_ok=True)
    (vault_path / "Sessions").mkdir(exist_ok=True)

    # 2. Markers & gitkeeps
    for keep_dir in [
        vault_path / "00-Inbox",
        vault_path / "User-Input" / "pending",
        vault_path / "User-Input" / "processed",
        vault_path / "Architecture" / "decisions",
    ]:
        gitkeep = keep_dir / ".gitkeep"
        if not gitkeep.exists():
            gitkeep.touch()

    # 3. Root notes
    write_vault_note_if_missing(vault_path / "Dashboard.md", get_dashboard_template())
    write_vault_note_if_missing(vault_path / "User-Input" / "README.md", get_user_input_readme_template())
    write_vault_note_if_missing(vault_path / "Architecture" / "00-Overview.md", get_architecture_overview_template())
    write_vault_note_if_missing(vault_path / "Architecture" / "contracts.md", get_architecture_contracts_template())
    write_vault_note_if_missing(vault_path / "Architecture" / "decisions" / "README.md", get_architecture_decisions_readme_template())
    write_vault_note_if_missing(vault_path / "Sessions" / "README.md", get_sessions_readme_template())

    # 4. Initial project notes
    initial_projects = [
        "agentkit",
        "repokit",
        "riced-kubuntu-os",
        "workstation-setup",
        "augurs-bazaar",
        "augurs-saber",
    ]
    for proj in initial_projects:
        write_vault_note_if_missing(vault_path / "Projects" / f"{proj}.md", get_project_template(proj))

    # 5. Maintain convenient symlink: Path.home() / "AgentVault" -> vault_path
    convenient_link = Path.home() / "AgentVault"
    if convenient_link != vault_path:
        try:
            if convenient_link.is_symlink():
                if convenient_link.resolve() != vault_path:
                    convenient_link.unlink()
                    convenient_link.symlink_to(vault_path)
            elif not convenient_link.exists():
                convenient_link.symlink_to(vault_path)
        except OSError:
            pass

    print_success(f"AgentVault initialized successfully: {vault_path}")
    print_info(f"Dashboard available at: {vault_path / 'Dashboard.md'}")

    # 6. Ensure vault_path and default AgentVault are in trustedWorkspaces
    harness = get_harness_adapter(getattr(args, "harness", "antigravity"))
    settings_path = (
        Path(args.settings_path).expanduser().resolve()
        if getattr(args, "settings_path", None)
        else (
            Path(os.environ["AGENTKIT_SETTINGS_PATH"]).expanduser().resolve()
            if os.environ.get("AGENTKIT_SETTINGS_PATH")
            else harness.get_default_settings_path()
        )
    )
    settings, exists = load_user_settings(settings_path)
    if "trustedWorkspaces" not in settings or not isinstance(settings["trustedWorkspaces"], list):
        settings["trustedWorkspaces"] = []

    target_workspaces = [
        str(vault_path),
        str(Path.home() / "AgentVault"),
    ]
    seen_workspaces: Set[str] = set()
    deduped_workspaces: List[str] = []
    for tw in settings["trustedWorkspaces"]:
        if tw not in seen_workspaces:
            deduped_workspaces.append(tw)
            seen_workspaces.add(tw)

    modified = False
    for tw in target_workspaces:
        if tw not in seen_workspaces:
            deduped_workspaces.append(tw)
            seen_workspaces.add(tw)
            modified = True

    if deduped_workspaces != settings["trustedWorkspaces"]:
        settings["trustedWorkspaces"] = deduped_workspaces
        modified = True

    if modified:
        save_json(settings_path, settings)
        print_success(f"Registered AgentVault in trustedWorkspaces: {settings_path}")

    return 0


def cmd_vault_status(args: argparse.Namespace) -> int:
    """Report status and note inventory of Obsidian AgentVault."""
    vault_path = resolve_vault_path(getattr(args, "path", None))
    is_json = getattr(args, "json", False)

    if not vault_path.exists() or not (vault_path / ".obsidian").is_dir():
        if is_json:
            print(json.dumps({
                "exists": False,
                "path": str(vault_path),
                "error": "Obsidian AgentVault does not exist or is not initialized."
            }, indent=2))
        else:
            print_failure(f"Obsidian AgentVault not found at {vault_path}. Run 'agentkit vault init' to initialize.")
        return 1

    total_notes = sum(1 for p in vault_path.rglob("*.md") if ".obsidian" not in p.parts)
    pending_dir = vault_path / "User-Input" / "pending"
    pending_files = sorted([p.name for p in pending_dir.glob("*.md") if not p.name.startswith(".")]) if pending_dir.exists() else []

    projects_dir = vault_path / "Projects"
    project_files = sorted([p.stem for p in projects_dir.glob("*.md") if not p.name.startswith(".")]) if projects_dir.exists() else []

    sessions_dir = vault_path / "Sessions"
    recent_session: Optional[str] = None
    if sessions_dir.exists():
        session_files = [p for p in sessions_dir.glob("*.md") if p.name != "README.md" and not p.name.startswith(".")]
        if session_files:
            session_files.sort(key=lambda p: (p.stat().st_mtime, p.name), reverse=True)
            recent_session = session_files[0].name

    if is_json:
        print(json.dumps({
            "exists": True,
            "path": str(vault_path),
            "total_notes": total_notes,
            "pending_notes": len(pending_files),
            "pending_files": pending_files,
            "active_projects": len(project_files),
            "projects": project_files,
            "recent_session": recent_session,
        }, indent=2))
        return 0

    print_step("Obsidian AgentVault Status")
    print_success(f"Vault Path: {vault_path}")
    print_success(f"Total Notes: {total_notes}")
    print_success(f"Active Projects: {len(project_files)} ({', '.join(project_files)})")
    if pending_files:
        print_warning(f"Pending User Notes: {len(pending_files)} ({', '.join(pending_files)})")
    else:
        print_success("Pending User Notes: 0")
    print_info(f"Most Recent Session: {recent_session or 'None'}")
    return 0


def cmd_vault_ingest(args: argparse.Namespace) -> int:
    """Ingest pending user directives from User-Input/pending/ and project notes in Obsidian AgentVault."""
    vault_path = resolve_vault_path(getattr(args, "path", None))
    is_json = getattr(args, "json", False)

    if not vault_path.exists():
        if is_json:
            print(json.dumps({"error": f"Obsidian AgentVault does not exist at {vault_path}", "ingested_count": 0, "items": []}, indent=2))
        else:
            print_failure(f"Obsidian AgentVault does not exist at {vault_path}")
        return 1

    pending_dir = vault_path / "User-Input" / "pending"
    processed_dir = vault_path / "User-Input" / "processed"
    processed_dir.mkdir(parents=True, exist_ok=True)

    ingested_items: List[Dict[str, Any]] = []
    iso_date = datetime.date.today().isoformat()
    iso_ts = datetime.datetime.now().astimezone().isoformat()

    # 1. Inspect User-Input/pending/
    if pending_dir.exists():
        for note_file in sorted(pending_dir.glob("*.md")):
            if note_file.name.startswith("."):
                continue
            raw_text = note_file.read_text(encoding="utf-8")
            meta, body = parse_frontmatter_and_body(raw_text)

            # Destination filename with date prefix
            if note_file.name.startswith(iso_date):
                dest_name = note_file.name
            else:
                dest_name = f"{iso_date}-{note_file.name}"
            dest_file = processed_dir / dest_name
            if dest_file.exists():
                counter = 1
                base_stem = dest_file.stem
                while dest_file.exists():
                    dest_file = processed_dir / f"{base_stem}_{counter}.md"
                    counter += 1

            audit_stamp = f"\n\n> [!check] Ingested by agentkit on {iso_ts}\n"
            processed_text = raw_text.rstrip() + audit_stamp
            dest_file.write_text(processed_text, encoding="utf-8")
            note_file.unlink()

            ingested_items.append({
                "source": f"User-Input/pending/{note_file.name}",
                "processed_path": f"User-Input/processed/{dest_file.name}",
                "title": meta.get("title", note_file.stem),
                "project": meta.get("project", getattr(args, "project", None) or "general"),
                "tags": meta.get("tags", []),
                "content": raw_text.strip(),
            })

    # 2. If --project specified, check Projects/<project>.md for ## Offline User Input & Notes
    project_arg = getattr(args, "project", None)
    if project_arg:
        proj_stem = project_arg[:-3] if project_arg.endswith(".md") else project_arg
        proj_file = vault_path / "Projects" / f"{proj_stem}.md"
        if proj_file.exists():
            proj_text = proj_file.read_text(encoding="utf-8")
            section_header = "## Offline User Input & Notes"
            if section_header in proj_text:
                parts = proj_text.split(section_header, 1)
                before_section = parts[0]
                section_and_after = parts[1]
                next_h2 = section_and_after.find("\n## ")
                if next_h2 != -1:
                    section_content = section_and_after[:next_h2]
                    after_section = section_and_after[next_h2:]
                else:
                    section_content = section_and_after
                    after_section = ""

                # Only lines before ### Processed Directives (or before audit stamps) are pending
                pending_section = section_content
                processed_section = ""
                if "### Processed Directives" in section_content:
                    parts_p = section_content.split("### Processed Directives", 1)
                    pending_section = parts_p[0]
                    processed_section = "### Processed Directives" + parts_p[1]

                meaningful_lines = []
                for line in pending_section.strip().splitlines():
                    line_s = line.strip()
                    if not line_s:
                        continue
                    if line_s.startswith("> [!todo]") or line_s.startswith("> Add task requests") or line_s.startswith("> [!check] Ingested"):
                        continue
                    meaningful_lines.append(line)

                if meaningful_lines:
                    directive_text = "\n".join(meaningful_lines).strip()
                    ingested_items.append({
                        "source": f"Projects/{proj_stem}.md",
                        "section": "Offline User Input & Notes",
                        "title": f"{proj_stem} Offline Notes",
                        "project": proj_stem,
                        "content": directive_text,
                    })
                    audit_entry = (
                        f"\n\n### Processed Directives\n"
                        f"{directive_text}\n\n"
                        f"> [!check] Ingested by agentkit on {iso_ts}\n"
                    )
                    if processed_section:
                        combined_processed = audit_entry + "\n" + processed_section.replace("### Processed Directives\n", "")
                    else:
                        combined_processed = audit_entry

                    reset_pending = "\n> [!todo] Pending Notes\n> Add task requests or design considerations here for automatic ingestion.\n"
                    new_section = reset_pending + combined_processed
                    updated_text = before_section + section_header + new_section + after_section
                    proj_file.write_text(updated_text, encoding="utf-8")

    if is_json:
        print(json.dumps({
            "ingested_count": len(ingested_items),
            "items": ingested_items,
        }, indent=2))
        return 0

    if not ingested_items:
        print_info("No pending user inputs found.")
        return 0

    print_step(f"Ingested {len(ingested_items)} Pending Directive(s)")
    for item in ingested_items:
        src = item["source"]
        dest = item.get("processed_path", src)
        print_success(f"{src} -> {dest}")
        snippet = item["content"].replace("\n", " ")
        if len(snippet) > 80:
            snippet = snippet[:77] + "..."
        print(f"    {BOLD}Directives:{RESET} {snippet}")

    return 0


def cmd_vault_sync(args: argparse.Namespace) -> int:
    """Idempotently sync project state, tasks, and ADR links in Obsidian AgentVault Projects/<project>.md."""
    vault_path = resolve_vault_path(getattr(args, "path", None))
    is_json = getattr(args, "json", False)

    if not vault_path.exists():
        if is_json:
            print(json.dumps({"error": f"Obsidian AgentVault does not exist at {vault_path}", "synced": []}, indent=2))
        else:
            print_failure(f"Obsidian AgentVault does not exist at {vault_path}")
        return 1

    projects_dir = vault_path / "Projects"
    projects_dir.mkdir(parents=True, exist_ok=True)

    project_arg = getattr(args, "project", None)
    if project_arg:
        target_projects = [project_arg[:-3] if project_arg.endswith(".md") else project_arg]
    else:
        found_projs = [p.stem for p in projects_dir.glob("*.md") if not p.name.startswith(".")]
        target_projects = found_projs if found_projs else [
            "agentkit",
            "repokit",
            "riced-kubuntu-os",
            "workstation-setup",
            "augurs-bazaar",
            "augurs-saber",
        ]

    # Collect available ADRs from Architecture/decisions
    decisions_dir = vault_path / "Architecture" / "decisions"
    adr_links: List[str] = []
    if decisions_dir.exists():
        for adr_file in sorted(decisions_dir.glob("*.md")):
            if adr_file.name == "README.md" or adr_file.name.startswith("."):
                continue
            adr_links.append(f"- [[Architecture/decisions/{adr_file.stem}|{adr_file.stem}]]")

    synced_projects: List[str] = []
    for proj in target_projects:
        proj_file = projects_dir / f"{proj}.md"
        if proj_file.exists():
            content = proj_file.read_text(encoding="utf-8")
            meta, body = parse_frontmatter_and_body(content)
            meta["last_updated"] = datetime.date.today().isoformat()
            meta["updated_by"] = "agentkit"
            if "status" not in meta:
                meta["status"] = "active"

            if adr_links:
                adr_block = "\n".join(adr_links)
                if "## Architecture Decisions (ADRs)" not in body:
                    body = body.rstrip() + f"\n\n## Architecture Decisions (ADRs)\n{adr_block}\n"

            if "## Active Tasks" not in body:
                body = body.rstrip() + "\n\n## Active Tasks\n- [ ] Sync project state and directives\n"

            tags = meta.pop("tags", ["project", proj])
            if isinstance(tags, str):
                tags = [tags]
            note_type = meta.pop("type", "project")
            updated_by = meta.pop("updated_by", "agentkit")
            new_fm = format_frontmatter(tags, note_type, updated_by, extra=meta)
            proj_file.write_text(new_fm + "\n\n" + body.strip() + "\n", encoding="utf-8")
        else:
            proj_file.write_text(get_project_template(proj), encoding="utf-8")

        synced_projects.append(proj)
        if not is_json:
            print_success(f"Synced project note: Projects/{proj}.md")

    if is_json:
        print(json.dumps({"synced": synced_projects}, indent=2))

    return 0


def cmd_vault_note(args: argparse.Namespace) -> int:
    """Create a structured note or append a section in Obsidian AgentVault."""
    vault_path = resolve_vault_path(getattr(args, "path", None))
    is_json = getattr(args, "json", False)

    if not vault_path.exists():
        if is_json:
            print(json.dumps({"error": f"Obsidian AgentVault does not exist at {vault_path}"}, indent=2))
        else:
            print_failure(f"Obsidian AgentVault does not exist at {vault_path}")
        return 1

    proj_arg = args.project
    proj_stem = proj_arg[:-3] if proj_arg.endswith(".md") else proj_arg
    title = args.title.strip()
    content = args.content.strip()

    # Collect tags
    tags: List[str] = ["project", proj_stem]
    if getattr(args, "tag", None):
        raw_tags = args.tag if isinstance(args.tag, list) else [args.tag]
        for item in raw_tags:
            for part in str(item).split(","):
                cleaned = part.strip()
                if cleaned and cleaned not in tags:
                    tags.append(cleaned)

    # Check if user specified a section to append into the project note directly
    section_arg = getattr(args, "section", None)
    if section_arg:
        proj_file = vault_path / "Projects" / f"{proj_stem}.md"
        if not proj_file.exists():
            proj_file.parent.mkdir(parents=True, exist_ok=True)
            proj_file.write_text(get_project_template(proj_stem), encoding="utf-8")

        proj_text = proj_file.read_text(encoding="utf-8")
        section_heading = f"## {section_arg}"
        if section_heading in proj_text:
            parts = proj_text.split(section_heading, 1)
            updated = parts[0] + section_heading + "\n" + content + "\n\n" + parts[1].lstrip("\n")
        else:
            updated = proj_text.rstrip() + f"\n\n{section_heading}\n{content}\n"
        proj_file.write_text(updated, encoding="utf-8")

        if is_json:
            print(json.dumps({
                "success": True,
                "action": "appended_section",
                "path": str(proj_file),
                "section": section_arg,
                "project": proj_stem,
            }, indent=2))
        else:
            print_success(f"Appended section '{section_arg}' to Projects/{proj_stem}.md")
        return 0

    # Otherwise, create or append to structured note in Projects/
    safe_title = re.sub(r"[^\w\-\s]", "", title).strip().replace(" ", "-")
    if not safe_title:
        safe_title = "note"

    note_file = vault_path / "Projects" / f"{safe_title}.md"
    action = "created"

    if note_file.exists():
        existing_text = note_file.read_text(encoding="utf-8")
        timestamp = datetime.datetime.now().astimezone().strftime("%Y-%m-%d %H:%M")
        appended_block = f"\n\n## {timestamp} Entry\n\n{content}\n"
        note_file.write_text(existing_text.rstrip() + appended_block, encoding="utf-8")
        action = "appended"
    else:
        note_file.parent.mkdir(parents=True, exist_ok=True)
        fm = format_frontmatter(tags=tags, note_type="note", updated_by="agentkit", extra={"project": proj_stem})
        body = f"""# {title}

> [!note] Project: [[Projects/{proj_stem}|{proj_stem}]]

{content}
"""
        note_file.write_text(fm + "\n\n" + body, encoding="utf-8")

    # Link from Projects/<project>.md if exists
    proj_file = vault_path / "Projects" / f"{proj_stem}.md"
    if proj_file.exists() and proj_file != note_file:
        proj_text = proj_file.read_text(encoding="utf-8")
        wikilink = f"- [[Projects/{safe_title}|{title}]]"
        if wikilink not in proj_text:
            if "## Related Notes" in proj_text:
                parts = proj_text.split("## Related Notes", 1)
                updated_proj = parts[0] + "## Related Notes\n" + wikilink + "\n" + parts[1].lstrip("\n")
            else:
                updated_proj = proj_text.rstrip() + f"\n\n## Related Notes\n{wikilink}\n"
            proj_file.write_text(updated_proj, encoding="utf-8")

    if is_json:
        print(json.dumps({
            "success": True,
            "action": action,
            "path": str(note_file),
            "project": proj_stem,
            "title": title,
            "tags": tags,
        }, indent=2))
    else:
        if action == "created":
            print_success(f"Created structured note: Projects/{note_file.name}")
        else:
            print_success(f"Appended content to existing note: Projects/{note_file.name}")

    return 0


# ==============================================================================
# Wake-Lock Command Handlers
# ==============================================================================


def cmd_wake_status(args: argparse.Namespace) -> int:
    """Fetch and print sleep wake-lock status."""
    from project.tools.wake.server import fetch_status
    port = getattr(args, "port", 18820)
    is_json = getattr(args, "json", False)
    status = fetch_status(port=port)
    if status is None:
        if is_json:
            print(json.dumps({"error": "WakeLock daemon is not running", "active": False}, indent=2))
        else:
            print_failure("AgentKit WakeLock daemon is not running.")
            print(f"  Start daemon with: {BOLD}agentkit wake daemon{RESET} or {BOLD}agentkit wake tray{RESET}")
        return 1
    if is_json:
        print(json.dumps(status, indent=2))
    else:
        state = status.get("state", "idle")
        inhibited = status.get("inhibited", False)
        active_count = status.get("active_count", 0)
        cooldown_remaining = status.get("cooldown_remaining", 0.0)
        print_step("AgentKit WakeLock Status")
        state_color = GREEN if state == "idle" else (YELLOW if state == "cooldown" else CYAN)
        print(f"  {BOLD}State:{RESET} {state_color}{state.upper()}{RESET}")
        print(f"  {BOLD}Sleep Inhibited:{RESET} {'Yes' if inhibited else 'No'}")
        print(f"  {BOLD}Active Agent Prompts:{RESET} {active_count}")
        if state == "cooldown":
            print(f"  {BOLD}Cooldown Remaining:{RESET} {cooldown_remaining:.1f}s")
        sessions = status.get("sessions", [])
        if sessions:
            print(f"\n  {BOLD}Active Sessions:{RESET}")
            for s in sessions:
                print(f"    - {BOLD}{s.get('agent_name', 'agent')}{RESET} (PID {s.get('pid', 0)}): {s.get('task', 'active')} [{s.get('session_id', '')}]")
    return 0


def cmd_wake_daemon(args: argparse.Namespace) -> int:
    """Start wake server daemon."""
    from project.tools.wake.engine import WakeEngine
    from project.tools.wake.inhibitor import get_system_inhibitor
    from project.tools.wake.server import WakeServer
    port = getattr(args, "port", 18820)
    print_step(f"Starting AgentKit WakeLock daemon on 127.0.0.1:{port}...")
    inhibitor = get_system_inhibitor()
    engine = WakeEngine(inhibitor=inhibitor)
    server = WakeServer(engine=engine, host="127.0.0.1", port=port)
    print_success(f"WakeLock daemon running (PID {os.getpid()}). Press Ctrl+C to terminate.")
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        print("\nStopping wake daemon...")
    finally:
        server.stop()
    return 0


def cmd_wake_tray(args: argparse.Namespace) -> int:
    """Start cross-platform system tray indicator."""
    from project.tools.wake.tray import run_tray
    embed_engine = getattr(args, "embed_engine", False)
    return run_tray(port=18820, embed_engine=embed_engine)


def cmd_wake_notify(args: argparse.Namespace) -> int:
    """Ping wake server with active/idle state."""
    from project.tools.wake.server import send_notification
    state = args.state
    session_id = getattr(args, "session", os.environ.get("ANTIGRAVITY_SESSION_ID", "default"))
    agent = getattr(args, "agent", os.environ.get("AGENTKIT_HARNESS", "agent"))
    task = getattr(args, "task", "")
    quiet = getattr(args, "quiet", False)
    ok = send_notification(session_id=session_id, state=state, agent=agent, task=task)
    if not quiet:
        if ok:
            print_success(f"Notified wake: {state} [{session_id}]")
        else:
            print_warning("Wake daemon not reachable (notification skipped).")
    return 0 if ok else 0  # hooks should not fail caller


def cmd_wake_watch(args: argparse.Namespace) -> int:
    """Live terminal ANSI loop of wake status."""
    import time
    from project.tools.wake.server import fetch_status
    print_step("AgentKit WakeLock Terminal Watcher (Press Ctrl+C to exit)")
    try:
        while True:
            status = fetch_status()
            sys.stdout.write("\x1b[2J\x1b[H")  # clear screen
            if status is None:
                print(f"{YELLOW}● Wake daemon is offline.{RESET} Waiting for connection...")
            else:
                state = status.get("state", "idle").upper()
                inhibited = "LOCKED" if status.get("inhibited") else "RELEASED"
                color = CYAN if state == "ACTIVE" else (YELLOW if state == "COOLDOWN" else GREEN)
                print(f"{BOLD}AgentKit WakeLock:{RESET} {color}{state}{RESET} | Power Sleep: {BOLD}{inhibited}{RESET}")
                sessions = status.get("sessions", [])
                print(f"Active Agent Count: {len(sessions)}")
                for s in sessions:
                    print(f"  ⚡ {s.get('agent_name')} [{s.get('session_id')}]: {s.get('task')}")
            time.sleep(1.0)
    except KeyboardInterrupt:
        print("\nExiting watcher.")
    return 0


def cmd_wake_autostart(args: argparse.Namespace) -> int:
    """Manage system startup autostart entry."""
    from project.tools.wake.autostart import enable_autostart, disable_autostart, is_autostart_enabled, get_autostart_path
    if getattr(args, "enable", False):
        ok, msg = enable_autostart()
        if ok:
            print_success(msg)
            return 0
        print_failure(msg)
        return 1
    elif getattr(args, "disable", False):
        ok, msg = disable_autostart()
        if ok:
            print_success(msg)
            return 0
        print_failure(msg)
        return 1
    else:
        # status check
        enabled = is_autostart_enabled()
        path = get_autostart_path()
        status_text = f"{GREEN}Enabled{RESET}" if enabled else f"{YELLOW}Disabled{RESET}"
        print(f"AgentKit Wake Autostart: {status_text} ({path})")
        return 0


def cmd_wake_override(args: argparse.Namespace) -> int:
    """Toggle manual sleep inhibition override."""
    from project.tools.wake.server import send_override
    enabled = getattr(args, "on", False)
    if getattr(args, "off", False):
        enabled = False
    ok = send_override(enabled=enabled)
    if ok:
        print_success(f"Wake manual awake override set to: {'ON' if enabled else 'OFF'}")
        return 0
    print_failure("Wake daemon not reachable.")
    return 1


def cmd_wake_log(args: argparse.Namespace) -> int:
    """Read and print session history journal."""
    import time
    from project.tools.wake.engine import WakeEngine
    from project.tools.wake.inhibitor import MockSleepInhibitor
    limit = getattr(args, "limit", 50)
    engine = WakeEngine(inhibitor=MockSleepInhibitor())
    history = engine.get_history(limit=limit)
    if not history:
        print_step("No wake-lock sessions recorded yet.")
        return 0
    print_step(f"Recent Wake Sessions (Last {len(history)}):")
    for entry in history:
        dur = entry.get("duration_seconds", 0)
        ts = time.strftime('%Y-%m-%d %H:%M:%S', time.localtime(entry.get("end_time", time.time())))
        print(f"  {ts} | {BOLD}{entry.get('agent_name', 'agent')}{RESET} ({entry.get('session_id', '')}): {entry.get('task', '')} [{dur:.1f}s prevented]")
    return 0


# Backward compatibility aliases
cmd_guard_status = cmd_wake_status
cmd_guard_daemon = cmd_wake_daemon
cmd_guard_tray = cmd_wake_tray
cmd_guard_notify = cmd_wake_notify
cmd_guard_watch = cmd_wake_watch
cmd_guard_autostart = cmd_wake_autostart
cmd_guard_override = cmd_wake_override
cmd_guard_log = cmd_wake_log


